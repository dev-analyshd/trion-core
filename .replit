modules = ["python-3.11", "web", "rust-stable", "nodejs-18", "go-1.21", "haskell-ghc9.4"]
[agent]
expertMode = true
stack = "FLASK_VANILLA_JS"

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "libxcrypt", "openssl", "postgresql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python serve.py"
waitForPort = 5000

[[workflows.workflow]]
name = "FAISS ANIMA"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 PORT=8000 FAISS_PORT=8000 uv run python3 akashic/faiss_service.py"
waitForPort = 8000

[[workflows.workflow]]
name = "Extended Chain Relayer"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd relayer && ORACLE_API_URL=\"http://127.0.0.1:5000\" EXTENDED_POLL_INTERVAL_MS=90000 node extended_chain_relayer.js"

[[workflows.workflow]]
name = "TRION Relayer"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "DATABASE_URL=\"$TIMESCALEDB_URL\" RELAYER_PRIVATE_KEY=\"$RELAYER_PRIVATE_KEY\" ZG_PRIVATE_KEY=\"$DEPLOY_0G_PRIVATE\" ORACLE_API_URL=\"http://127.0.0.1:5000\" POLL_INTERVAL_MS=60000 ZG_EXECUTION_GATE_ADDR=\"0xA85B49C73B5710d9ddB1CB5a94c52D0F33c4199b\" ZG_POLL_INTERVAL_MS=120000 ZG_CHAIN_ID=16661 ZERO_G_RPC=\"https://evmrpc.0g.ai\" bash supervisors/trion_and_zg_relayer.sh"

[[workflows.workflow]]
name = "Native Relayer"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd native-relayer && ORACLE_API_URL=\"http://127.0.0.1:5000\" FAISS_URL=\"http://127.0.0.1:8000\" node native_relayer.js"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FAISS ANIMA"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Rust Indexers"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TRION Relayer"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Attack Alert Webhook"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Extended Chain Relayer"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TRION Dashboard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Native Relayer"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Genesis Backfill"

[[workflows.workflow]]
name = "Rust Indexers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "FAISS_SERVICE_URL=\"http://127.0.0.1:8000\" bash supervisors/rust_indexers.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Attack Alert Webhook"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ORACLE_API_URL=http://127.0.0.1:5000 WEBHOOK_PORT=6000 uv run python3 attack_alert_webhook.py"

[[workflows.workflow]]
name = "TRION Dashboard"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd dashboard && npm run dev"
waitForPort = 3000

[[workflows.workflow]]
name = "Genesis Backfill"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/genesis_backfill_runner.sh"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6000
externalPort = 6000

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "main:app"]

[userenv]

[userenv.shared]
ZG_AKASHIC_CONTRACT = "0x33c793fed5bf5fcB043D8c6c74256e7B4b38156D"
BACKFILL_BATCH = "1000"
BACKFILL_WORKERS = "4"
CHAIN_ID = "42161"
EXTENDED_POLL_INTERVAL_MS = "90000"
FAISS_CENTROIDS_PATH = "./akashic/archetype_centroids.npy"
FAISS_INDEX_PATH = "./akashic/akashic_faiss.index"
FAISS_PORT = "8000"
FAISS_SERVICE_URL = "http://127.0.0.1:8000"
FAISS_STATE_DB = "./akashic/faiss_state.db"
FAISS_URL = "http://127.0.0.1:8000"
GK_STATE_PATH = "./data/trion_gk_state.json"
MKL_NUM_THREADS = "1"
MONITORED_ENTITIES = "0xb819c63c02Ed5aB49017C0f3f2568A14624658b3,uniswap,aave,compound"
NUMEXPR_NUM_THREADS = "1"
OMP_NUM_THREADS = "1"
OPENBLAS_NUM_THREADS = "1"
ORACLE_API_URL = "http://127.0.0.1:5000"
ORACLE_PUBLIC_DIR = "./akashic-oracle/public"
POLL_INTERVAL_MS = "60000"
POLL_MS = "10000"
POLL_SLEEP_MS = "1500"
PORT = "5000"
SOLANA_CHAIN_ID = "103"
SOLANA_LABEL = "SOLANA_DEVNET"
TON_TESTNET = "true"
TRION_API_URL = "http://127.0.0.1:5000"
TRION_ORACLE_V3 = "0xb819c63c02Ed5aB49017C0f3f2568A14624658b3"
TRION_VAULT_V3 = "0x93fD8a351C48317Ca3b38923d7ad2937aD9E716D"
ZG_CHAIN_ID = "16601"
ZG_DA_ENDPOINT = "https://da-node.0g.ai"
ZG_EXECUTION_GATE_ADDR = "0xA85B49C73B5710d9ddB1CB5a94c52D0F33c4199b"
ZG_POLL_INTERVAL_MS = "120000"
ZG_STORAGE_ENDPOINT = "https://indexer-storage-testnet-standard.0g.ai"
