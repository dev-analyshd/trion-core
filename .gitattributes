# Runtime binary files — do NOT track in git or LFS
# These are regenerated at runtime and are too large for version control.
# akashic_faiss.index, akashic_state.db, akashic_state.db.bak
# are intentionally excluded from all git tracking.
akashic/akashic_faiss.index filter=lfs diff=lfs merge=lfs -text
akashic/akashic_state.db filter=lfs diff=lfs merge=lfs -text
akashic_state.db filter=lfs diff=lfs merge=lfs -text
bh_ledger.db filter=lfs diff=lfs merge=lfs -text
