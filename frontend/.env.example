# ─── TRION Frontend Environment Variables ────────────────────────────────────
# Copy to .env.local for development, set in Render/Vercel dashboard for prod.

# Backend (Flask) URL — used by Next.js server-side rewrites ONLY.
# In production this is the internal Flask URL (http://127.0.0.1:5000 inside
# the same Render container). Next.js proxies /api/* and /app/api/* here.
FLASK_URL=http://127.0.0.1:5000

# Public API base URL — used by client-side fetch.
# Leave EMPTY in production (Next.js rewrites handle /api/* same-origin).
# In dev against a remote Flask, set to https://api.trion.io
NEXT_PUBLIC_API_BASE=

# Optional explicit socket.io endpoint for real-time streaming (lib/socketio.ts).
# Example: wss://api.trion.io  — if unset, same-origin /socket.io is used and
# views keep their useStream polling fallback. (The old native-WebSocket hook
# useWebSocket was dead code — removed in W4-Q.)
NEXT_PUBLIC_WS_URL=

# ─── Wallet / Web3 (public, no secrets) ──────────────────────────────────────
# WalletConnect project ID (get one at https://cloud.walletconnect.com)
# NEXT_PUBLIC_WC_PROJECT_ID=trion-protocol

# ─── Optional analytics ──────────────────────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=
