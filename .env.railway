# =============================================================================
# TRION Protocol — Railway Environment Variables (v8.1)
#
# Copy these into Railway Dashboard → Variables tab.
# Railway also supports referencing variables from other services:
#   ${{postgres.DATABASE_URL}}  (if you add a Postgres database)
#
# Variables marked [AUTO] are set automatically by railway.json.
# Variables marked [REQUIRED] must be set manually.
# Variables marked [OPTIONAL] have sensible defaults.
#
# WHAT THIS IMAGE RUNS (Dockerfile.railway → railway-entrypoint.sh):
#   Next.js frontend (public $PORT) + Flask Oracle API (:5000 internal,
#   gunicorn) + FAISS ANIMA (:8000 internal) + BH streamer (background).
#   It is an OBSERVATION stack: the relayer is NOT started here —
#   TRION_ENABLE_RELAYER is read by nothing in the railway entrypoint, and
#   relayer/private keys set in Railway variables would sit unread.
#   On-chain signing belongs to the render/full stack (Dockerfile.render,
#   supervisors/trion_and_zg_relayer.sh — see DEPLOYMENT.md "Signing and
#   key custody" for the KMS/HSM matrix).
# =============================================================================

# ── Core Service Ports (AUTO) ──────────────────────────────────────────────
PORT=                       # [AUTO] Railway injects this automatically
HOSTNAME=0.0.0.0            # [AUTO] Bind to all interfaces
FLASK_PORT=5000             # [AUTO] Internal Flask port
FAISS_PORT=8000             # [AUTO] Internal FAISS port
FLASK_URL=http://127.0.0.1:5000  # [AUTO] Next.js rewrite target
FAISS_URL=http://127.0.0.1:8000  # [AUTO] FAISS service URL
FAISS_SERVICE_URL=http://127.0.0.1:8000  # [AUTO]
ORACLE_API_URL=http://127.0.0.1:5000     # [AUTO]

# ── Python/Runtime (AUTO) ───────────────────────────────────────────────────
PYTHONUNBUFFERED=1          # [AUTO] Real-time log output
PYTHONDONTWRITEBYTECODE=1   # [AUTO] No .pyc files
NODE_ENV=production         # [AUTO] Next.js production mode
PYTHONPATH=/app             # [AUTO] Python import path

# ── Service Toggles (read by the railway entrypoint) ────────────────────────
TRION_ENABLE_STREAMER=1     # [AUTO] BH streamer (real-time behavioral hash ingestion)
TRION_ENABLE_VALIDATOR=0    # Go validator mesh + TRION-BFT self-test
                           # (one-shot, prints PASS and exits — no daemon)
TRION_ENABLE_SIGNAL_PROCESSING=0  # C++ FFT signal engine (needs cmake at runtime)
TRION_MAX_CHAINS=12         # [TUNABLE] 12 (Hobby) / 0 (Pro, all 96 chains)

# ── Database (OPTIONAL — SQLite fallback if absent) ────────────────────────
DATABASE_URL=               # [OPTIONAL] PostgreSQL connection string
TIMESCALEDB_URL=            # [OPTIONAL] Same as DATABASE_URL (alias)
BH_LEDGER_DB=/app/bh_ledger.db  # [AUTO] SQLite path for behavioral hashes

# ── 0G Mainnet (AUTO — public RPC, read-only; no key needed) ───────────────
ZG_NETWORK=mainnet
ZG_CHAIN_ID=16661
ZERO_G_RPC=https://evmrpc.0g.ai
ZG_EXECUTION_GATE_ADDR=0xA85B49C73B5710d9ddB1CB5a94c52D0F33c4199b

# ── API Key (OPTIONAL) ─────────────────────────────────────────────────────
TRION_API_KEY=              # [OPTIONAL] Set to require X-API-Key for POST/PUT/DELETE

# ── Rate Limiting (OPTIONAL) ───────────────────────────────────────────────
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_CLEANUP_INTERVAL=300

# ── Gunicorn (OPTIONAL — read by railway-entrypoint.sh) ────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# ── Signing custody (see DEPLOYMENT.md "Signing and key custody") ──────────
# TRION_ENV=production makes the entrypoint refuse raw env private keys
# (this stack is read-only anyway — leave unset unless you add signing
# processes yourself). TRION_ALLOW_RAW_ENV_KEYS=1 acknowledges env-secret
# custody; KMS_PROVIDER + provider vars are for the relayer stack.
TRION_ENV=
TRION_ALLOW_RAW_ENV_KEYS=
KMS_PROVIDER=

# ════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT STEPS:
# ════════════════════════════════════════════════════════════════════════════
#
# 1. Go to https://railway.com and sign in with GitHub
# 2. Click "New Project" → "Deploy from GitHub repo"
# 3. Select the dev-analyshd/trion-core repository
# 4. Railway auto-detects railway.json and starts building
# 5. Wait ~5-8 minutes for the build to complete
# 6. Railway assigns a URL: trion-core-production.up.railway.app
# 7. Visit the URL — the dashboard loads with live BH streaming data
#
# For custom domain: Settings → Networking → Generate Domain
# For PostgreSQL: + Add → Database → PostgreSQL
#   Then set DATABASE_URL to ${{postgres.DATABASE_URL}}
# For persistent storage: + Add → Volume → mount at /app/data
#
# What runs inside the container:
#   - Next.js frontend (public port $PORT)
#   - Flask Oracle API (internal port 5000)
#   - FAISS ANIMA Engine (internal port 8000)
#   - BH Streamer (background, indexes 12 chains by default)
#   - Protocol monitor (Uniswap, Aave, Compound, 0G) — in-process threads
#   - Self-verification monitor (reflexive, 120s interval) — in-process thread
#   - NO relayer / no on-chain signing (observation stack — see header)
#
# All 14 languages included in the image:
#   Python, Rust, Solidity, Vyper, Cairo, Go, Haskell, Julia, C++,
#   Move, FunC, TypeScript, JavaScript, Circom
