# =============================================================================
# TRION Protocol — Railway Environment Variables
#
# Copy these into Railway Dashboard → Variables tab.
# Railway also supports referencing variables from other services:
#   ${{postgres.DATABASE_URL}}  (if you add a Postgres database)
#
# Variables marked [AUTO] are set automatically by railway.json.
# Variables marked [REQUIRED] must be set manually.
# Variables marked [OPTIONAL] have sensible defaults.
# =============================================================================

# ── Core Service Ports (AUTO — set by railway.json) ──────────────────────────
PORT=                       # [AUTO] Railway injects this automatically
HOSTNAME=0.0.0.0            # [AUTO] Bind to all interfaces
FLASK_PORT=5000             # [AUTO] Internal Flask port
FAISS_PORT=8000             # [AUTO] Internal FAISS port
FLASK_URL=http://127.0.0.1:5000  # [AUTO] Next.js rewrite target
FAISS_URL=http://127.0.0.1:8000  # [AUTO] FAISS service URL
FAISS_SERVICE_URL=http://127.0.0.1:8000  # [AUTO]
ORACLE_API_URL=http://127.0.0.1:5000     # [AUTO]

# ── Python/Runtime (AUTO) ────────────────────────────────────────────────────
PYTHONUNBUFFERED=1          # [AUTO] Real-time log output
PYTHONDONTWRITEBYTECODE=1   # [AUTO] No .pyc files
NODE_ENV=production         # [AUTO] Next.js production mode

# ── Service Toggles (AUTO) ───────────────────────────────────────────────────
TRION_ENABLE_FAISS=1        # [AUTO] Start FAISS ANIMA engine
TRION_ENABLE_RUST=0         # [AUTO] Skip Rust indexers (too heavy for Railway)
TRION_ENABLE_RELAYER=0      # [AUTO] Skip on-chain relayer (no keys)
TRION_ENABLE_ZG_SYNC=0      # [AUTO] Skip 0G sync daemon
TRION_ENABLE_ZG_DA=0        # [AUTO] Skip 0G DA streamer
TRION_ENABLE_EXTRAS=0       # [AUTO] Skip extended VM indexers
TRION_ENABLE_NATIVE=0       # [AUTO] Skip native VM indexers

# ── Streamer + Performance (v7.0.0+) ─────────────────────────────────────────
# Streamer is now ON by default — the entrypoint owns the single dedicated
# process. TRION_MAX_CHAINS caps concurrent chain-indexer threads:
#   12  → 512MB Railway Hobby plan (default)
#   0   → 8GB+ plan (0 = all 96 mainnet chains)
TRION_ENABLE_STREAMER=1     # [AUTO] BH streamer (96 mainnet chains)
TRION_MAX_CHAINS=12         # [TUNABLE] 12 (Hobby) / 0 (Pro, all chains)

# ── Pre-mainnet Validation (OPTIONAL — off by default) ─────────────────────
# When set to 1, the preflight script will fail-closed if 0G mainnet RPC is
# unreachable. Useful during pre-mainnet validation runs; leave 0 in
# production — public RPCs geo-block and the streamer has its own failover.
TRION_REQUIRE_RPC=0        # [OPTIONAL] 1 = fail-closed on RPC unreachable

# ── Database (OPTIONAL — SQLite fallback if absent) ──────────────────────────
DATABASE_URL=               # [OPTIONAL] PostgreSQL connection string
TIMESCALEDB_URL=            # [OPTIONAL] Same as DATABASE_URL (alias)

# ── 0G Mainnet (AUTO — public RPC, no key needed) ────────────────────────────
ZG_NETWORK=mainnet          # [AUTO]
ZG_CHAIN_ID=16661           # [AUTO]
ZERO_G_RPC=https://evmrpc.0g.ai  # [AUTO] Public 0G RPC
ZG_EXECUTION_GATE_ADDR=0xA85B49C73B5710d9ddB1CB5a94c52D0F33c4199b  # [AUTO]

# ── API Key (OPTIONAL — for write operations) ────────────────────────────────
TRION_API_KEY=              # [OPTIONAL] Set to require X-API-Key header for POST/PUT/DELETE

# ── Rate Limiting (OPTIONAL) ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SEC=60    # [OPTIONAL] Sliding window length (default: 60)
RATE_LIMIT_MAX_REQUESTS=300 # [OPTIONAL] Max requests per window per IP (default: 300)
RATE_LIMIT_CLEANUP_INTERVAL=300  # [OPTIONAL] Background cleanup interval (default: 300)

# ── Gunicorn (OPTIONAL) ──────────────────────────────────────────────────────
GUNICORN_WORKERS=2          # [OPTIONAL] Number of Flask workers (default: 2)
GUNICORN_THREADS=4          # [OPTIONAL] Threads per worker (default: 4)
GUNICORN_TIMEOUT=120        # [OPTIONAL] Request timeout (default: 120)

# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL: Relayer Private Keys (for on-chain signal publishing)
# If these are NOT set, the relayer runs in DRY_RUN mode (no on-chain txs).
# Only set these if you want to publish real behavioral signals on-chain.
# ════════════════════════════════════════════════════════════════════════════

# ── EVM Relayer Key ──────────────────────────────────────────────────────────
RELAYER_PRIVATE_KEY=0x...   # [OPTIONAL] EVM signing key for signal publishing

# ── Solana Relayer Key ───────────────────────────────────────────────────────
SVM_PRIVATE_KEY_B58=        # [OPTIONAL] Solana base58 private key

# ── 0G Mainnet Key ───────────────────────────────────────────────────────────
ZG_PRIVATE_KEY=0x...        # [OPTIONAL] 0G mainnet signing key

# ── Other VM Keys (all OPTIONAL) ─────────────────────────────────────────────
NEAR_PRIVATE_KEY=           # [OPTIONAL] ed25519:... format
TON_PRIVATE_KEY_HEX=        # [OPTIONAL] TON hex private key
DOT_MNEMONIC=               # [OPTIONAL] Polkadot BIP39 mnemonic
STARKNET_PRIVATE_KEY=       # [OPTIONAL] StarkNet signing key
BTC_TAPROOT_WIF=            # [OPTIONAL] Bitcoin Taproot WIF
BTC_SEGWIT_NATIVE_WIF=      # [OPTIONAL] Bitcoin SegWit WIF
BTC_SEGWIT_NESTED_WIF=      # [OPTIONAL] Bitcoin Nested SegWit WIF
BTC_LEGACY_WIF=             # [OPTIONAL] Bitcoin Legacy WIF
LITECOIN_PRIVATE_KEY=       # [OPTIONAL] Litecoin private key
DOGE_PRIVATE_KEY=           # [OPTIONAL] Dogecoin private key
DASH_PRIVATE_KEY=           # [OPTIONAL] Dash private key
COSMOS_PRIVATE_KEY=         # [OPTIONAL] Cosmos SDK private key
KAVA_PRIVATE_KEY=           # [OPTIONAL]
INJECTIVE_PRIVATE_KEY=      # [OPTIONAL]
SEI_PRIVATE_KEY=            # [OPTIONAL]
DYDX_PRIVATE_KEY=           # [OPTIONAL]
INITIA_PRIVATE_KEY=         # [OPTIONAL]
APTOS_PRIVATE_KEY=          # [OPTIONAL]
MOVEMENT_PRIVATE_KEY=       # [OPTIONAL]
SUI_PRIVATE_KEY=            # [OPTIONAL]
TRON_PRIVATE_KEY=           # [OPTIONAL]
TRON_API_KEY=               # [OPTIONAL] TronGrid API key
PI_SECRET_KEY=              # [OPTIONAL] Pi Network Stellar secret key

# ── GitHub (OPTIONAL) ────────────────────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=  # [OPTIONAL] For auto-push features

# ════════════════════════════════════════════════════════════════════════════
# RAILWAY-SPECIFIC NOTES
# ════════════════════════════════════════════════════════════════════════════
#
# 1. Railway automatically sets PORT — do NOT override it.
# 2. Railway health check path is /readyz (configured in railway.json).
#    /readyz returns 503 during cold-start (FAISS loading) and 200 once the
#    whole Next.js → Flask → FAISS chain is ready. This prevents traffic
#    from being routed to a half-booted container.
# 3. The app uses SQLite (/app/bh_ledger.db) by default. For persistent
#    storage, add a Railway Volume mount at /app/data and set DATABASE_URL
#    to a PostgreSQL database (Railway provides free Postgres).
# 4. The BH streamer writes to /app/bh_ledger.db. This is ephemeral by
#    default. To persist, mount a volume at /app.
# 5. Build time: ~5 minutes. Memory: ~512MB minimum (1GB recommended).
# 6. The deployment exposes a single port (Next.js). All API requests
#    to /api/* are proxied internally to Flask on port 5000.
# 7. FAISS ANIMA engine runs on port 8000 (internal, not exposed).
# 8. BH streamer polls 96 mainnet chains (EVM, SVM, Cosmos, Move, TVM,
#    UTXO, Starknet, NEAR, PVM, XRPL, Stellar, Hedera, MultiversX, VeChain,
#    Waves, Algorand, Cardano) for real behavioral data.
#
# ════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT STEPS:
# ════════════════════════════════════════════════════════════════════════════
#
# 1. Go to https://railway.com and sign in with GitHub.
# 2. Click "New Project" → "Deploy from GitHub repo".
# 3. Select the dev-analyshd/trion-core repository.
# 4. Railway will auto-detect railway.json and start building.
# 5. Wait ~5 minutes for the build to complete.
# 6. Railway assigns a URL like: trion-core-production.up.railway.app
# 7. Visit the URL — the dashboard will load with live BH streaming data.
#
# For custom domain: Settings → Networking → Generate Domain.
# For PostgreSQL: + Add → Database → PostgreSQL. Then set DATABASE_URL
#   to ${{postgres.DATABASE_URL}} in the Variables tab.
