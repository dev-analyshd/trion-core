# ==============================================================================
# TRION Core — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
#
# Sections:
#   1. Core (Akashic Oracle web service)             — REQUIRED
#   2. FAISS / Intelligence Engine                   — REQUIRED
#   3. L0 EVM Indexer (multi-chain block streamer)   — RECOMMENDED
#   4. EVM Relayer (publishes signals on 7 chains)   — OPTIONAL (DRY_RUN if unset)
#   5. Native VM Indexers (NEAR/TON/PVM/StarkNet)    — OPTIONAL (uses public RPCs)
#   6. Native VM Relayer (real signed txs)           — OPTIONAL (skips per-VM if unset)
#   7. Multi-chain expansion (BTC/UTXO/Tron/Cosmos…) — OPTIONAL
#   8. ANIMA off-chain intelligence                  — OPTIONAL (heavy ratelimit if unset)
#   9. Smart-contract deployment / verification      — OPTIONAL (Hardhat only)
# ==============================================================================


# ── 1. Core: Akashic Oracle web service ───────────────────────────────────────
# Port the Axum server binds to. Render injects PORT automatically; locally
# default is 5000 in this repl, 10000 in Docker/Render.
PORT=5000

# Static dashboard directory served at "/". Default works in Docker.
ORACLE_PUBLIC_DIR=./akashic-oracle/public

# TimescaleDB / Postgres connection string. The oracle stores oracle_signals
# and l0_state hypertables here. On Replit, set TIMESCALEDB_URL=$DATABASE_URL.
TIMESCALEDB_URL=
DATABASE_URL=


# ── 2. FAISS / Intelligence Engine (Python) ──────────────────────────────────
# Where the oracle and indexers POST behavioral vectors and read ANIMA results.
# In Docker compose this is http://faiss-engine:8000.
# In Render single-container this is http://127.0.0.1:8000 (bundled).
FAISS_SERVICE_URL=http://127.0.0.1:8000
FAISS_URL=http://127.0.0.1:8000     # alias used by some Node indexers
FAISS_PORT=8000

# Where the FAISS service persists its index + state (default: ./akashic/).
FAISS_INDEX_PATH=./akashic/akashic_faiss.index
FAISS_CENTROIDS_PATH=./akashic/archetype_centroids.npy
FAISS_STATE_DB=./akashic/faiss_state.db


# ── 3. L0 EVM Indexer (Rust streamer for 7 EVM chains) ───────────────────────
# Public RPCs work but are aggressively rate-limited. Provide your own
# Alchemy / Infura / Ankr / QuickNode keys for production stability.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ETHEREUM_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon-rpc.com
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://sepolia.base.org
BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
HSK_RPC_URL=https://mainnet.hsk.xyz
BNB_RPC_URL=https://bsc-testnet-rpc.publicnode.com
AVAX_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Chain ID & on-disk state for the L0 daemon.
CHAIN_ID=42161
GK_STATE_PATH=./data/trion_gk_state.json


# ── 4. EVM Relayer (Node, publishes on 7 chains every POLL_INTERVAL_MS) ──────
# If RELAYER_PRIVATE_KEY is unset the relayer runs in DRY_RUN mode (logs only,
# no on-chain transactions). Use a dedicated, low-funded wallet for testnet.
RELAYER_PRIVATE_KEY=
ORACLE_API_URL=http://127.0.0.1:5000
POLL_INTERVAL_MS=60000

# Comma-separated list of entities the relayer should monitor.
# Hex addresses or string entity IDs both supported (see deriveTxId in relayer.js).
MONITORED_ENTITIES=0xb819c63c02Ed5aB49017C0f3f2568A14624658b3,uniswap,aave,compound


# ── 5. Native VM Indexers (Node + Python supervisors) ────────────────────────
# These hit public testnet RPCs by default. Override only if you have private
# endpoints with higher quotas.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CHAIN_ID=103
SOLANA_LABEL=SOLANA_DEVNET
POLL_SLEEP_MS=1500
POLL_MS=10000
SUBSTRATE_WS=wss://westend-rpc.polkadot.io
TON_TESTNET=true
TON_API_URL=https://testnet.toncenter.com/api/v2
TON_API_KEY=
STARKNET_RPC_URL=
TRION_API_URL=http://127.0.0.1:5000


# ── 6. Native VM Relayer (signing keys — TESTNET ONLY) ───────────────────────
# Each VM is independently optional. Missing → that VM is skipped per cycle.
# Multiple alias names accepted; the relayer picks the first non-empty.
# !!! Use throwaway wallets only. Never commit. Never reuse for mainnet. !!!

# Solana Devnet — base58 secret key (64-byte ed25519 keypair).
SOLANA_RELAYER_PRIVATE_KEY=
SVM_PRIVATE_KEY_B58=
SOLANA_KEYPAIR=

# NEAR Testnet — ed25519:... secret key + matching account.
NEAR_RELAYER_PRIVATE_KEY=
NEAR_PRIVATE_KEY=
NEAR_ACCOUNT_ID=
NEAR_MAINNET=false

# TON Testnet — 64-char hex of the ed25519 secret seed.
TON_RELAYER_PRIVATE_KEY=
TON_PRIVATE_KEY_HEX=

# Polkadot/Westend (PVM) — 12 or 24 word BIP39 mnemonic.
PVM_RELAYER_MNEMONIC=
DOT_MNEMONIC=
DOT_SEED=

# StarkNet Sepolia — 0x… private key. Account address optional (auto-derived).
STARKNET_RELAYER_PRIVATE_KEY=
STARKNET_PRIVATE_KEY=
STARKNET_ACCOUNT_ADDRESS=
STK_TX_COUNT=5

# Native relayer cycle tuning.
NATIVE_CYCLE_SLEEP_MS=600000
NATIVE_PER_VM_SLEEP_MS=30000
SOLANA_RPC=https://api.devnet.solana.com


# ── 7. Multi-chain expansion (BTC/UTXO/Tron/Cosmos/Move/Sui/Pi adapters) ─────
# Per-VM testnet credentials for `npm run trion:index-all` and the BTCP
# multichain coordinator. All optional — adapters fall back to derived
# read-only addresses if signing keys are absent.
BTC_WIF_LEGACY=
BTC_WIF_SEGWIT_NESTED=
BTC_WIF_SEGWIT_NATIVE=
BTC_WIF_TAPROOT=
LTC_WIF=
LTC_ADDRESS=
DOGE_WIF=
DOGE_ADDRESS=
DASH_WIF=
DASH_ADDRESS=
TRON_PRIVATE_KEY=
TRONGRID_API_KEY=
SUI_PRIVATE_KEY=
PI_SECRET=

# On-chain contract registry used by chain adapters / BTCP coordinator.
TRION_ORACLE_ADDRESS=0xb819c63c02Ed5aB49017C0f3f2568A14624658b3
BEO_ATTESTATION_ADDRESS=
BIRP_ATTESTATION_ADDRESS=
BTCFI_GUARD_ADDRESS=
TRION_INK_ADDRESS=
TRION_SVM_PROGRAM_ID=


# ── 8. ANIMA off-chain intelligence (GitHub source crawler) ──────────────────
# Used by akashic/anima_engine.py to crawl commits, contributors, and issues.
# Without this the GitHub plane falls back to neutral priors (A=0.70).
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOKEN=                      # alias accepted

# FAISS backfill tuning (cold-start ANIMA index).
BACKFILL_BATCH=1000
BACKFILL_WORKERS=4


# ── 9. 0G Chain Integration (ExecutionGate + Storage + DA) ───────────────────
# TRIONExecutionGate deployed on 0G Galileo testnet (chainId 16602).
# To deploy to 0G Aristotle mainnet: NETWORK=mainnet node scripts/deploy_execution_gate_0g.mjs

# 0G Galileo Testnet (chain 16602)
ZERO_G_RPC=https://evmrpc-testnet.0g.ai
ZG_CHAIN_ID=16602
ZG_EXECUTION_GATE_ADDR=0xDB5910Dc6CfD219D00F64be1F23DA0289901356d
ZG_ORACLE_ADDR=0x0471B2BE25c2eBbAe7FAc17383F1692979F0A87C

# 0G Mainnet (chain 16661) — fill after mainnet deployment
# audit fix (ZG-2): was "Aristotle Mainnet (chain 16601)" — no such chain; canonical id is 16661
ZG_MAINNET_RPC=https://evmrpc.0g.ai
ZG_MAINNET_EXECUTION_GATE_ADDR=

# 0G Service endpoints
ZG_DA_ENDPOINT=https://da-node.0g.ai
ZG_STORAGE_ENDPOINT=https://indexer-storage-testnet-standard.0g.ai

# 0G ExecutionGate relayer tuning
ZG_POLL_INTERVAL_MS=120000

# FAISS index path for 0G Storage sync
FAISS_INDEX_PATH=./akashic/akashic_faiss.index


# ── 10. Smart-contract deployment & verification (Hardhat) ───────────────────
# Used only by hardhat/scripts/* — never read at runtime.
DEPLOYER_PRIVATE_KEY=              # 0x… fresh wallet, never reuse
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=

# On-chain addresses (Arbitrum Sepolia testnet).
TRION_ORACLE_V3=0xb819c63c02Ed5aB49017C0f3f2568A14624658b3
TRION_VAULT_V3=0x93fD8a351C48317Ca3b38923d7ad2937aD9E716D


# ── 11. BOT Chain (AI-agent EVM L1, chainId 677) ─────────────────────────────
# The 14th Rust indexer crate (trion-botchain) and chains/botchain/execute.ts
# adapter use these variables. Block-proof mode is used when no private key is set.
BOT_CHAIN_RPC_URL=https://rpc.botchain.ai
BOT_CHAIN_PRIVATE_KEY=                  # 0x… hex private key for signed txs
BOT_CHAIN_RELAYER_PRIVATE_KEY=          # alias for BOT_CHAIN_PRIVATE_KEY
BOT_CHAIN_ORACLE_ADDR=                  # TRIONOracleV3 address on BOT Chain
BOT_CHAIN_SCAN_URL=https://scan.botchain.ai


# ── 12. Institutional Dashboard ──────────────────────────────────────────────
# The new /app/* dashboard routes. These are read by dashboard_routes.py.
DASHBOARD_ENABLE=true                   # set to false to disable /app/* routes
ORACLE_INTERNAL_URL=http://127.0.0.1:5000  # internal Oracle API URL for proxy
FAISS_SERVICE_URL=http://127.0.0.1:8000   # FAISS ANIMA engine URL


# ── 13. API security ─────────────────────────────────────────────────────────
# Optional API key for write operations (POST/PUT/DELETE). Reads remain public.
# When set, clients must send X-API-Key header with this value.
TRION_API_KEY=                          # leave empty for open access (dev)


# ── 14. BTCP contracts (deployed) ────────────────────────────────────────────
# Addresses of BTCP-related contracts after deployment.
BTCP_INTENT_ADDR=
BTCP_ESCROW_ADDR=
BTCP_ROUTE_ADDR=
BTCP_BLO_ADDR=
BTCP_VERSION_REGISTRY_ADDR=
LIQUIDITY_OCEAN_ADDR=
GENESIS_COMMITMENT_ADDR=
TRAVEL_RULE_COMPLIANCE_ADDR=
CONTINUUM_DEX_ADDR=
TRION_GUARD_V3_ADDR=



# ── 15. React Frontend (Next.js) ─────────────────────────────────────────────
# The React frontend runs on $PORT and proxies /api/* to Flask on FLASK_PORT.
# On Render, PORT is injected automatically. Locally, Next.js runs on 3000.
PORT=10000
FLASK_PORT=5000
FLASK_URL=http://127.0.0.1:5000
NEXT_PUBLIC_API_BASE=

# ── 16. TimescaleDB (PostgreSQL) ─────────────────────────────────────────────
# When set to a postgresql:// URL, the system dual-writes all BH records
# and FAISS vectors to TimescaleDB for persistent storage.
# If not set, falls back to SQLite (bh_ledger.db).
# On Render, set this to the Render PostgreSQL internal connection string.
DATABASE_URL=
TIMESCALEDB_URL=

# ── 17. Public RPCs (all chains) ─────────────────────────────────────────────
# These are pre-configured in the Rust indexers. Override only if needed.
# EVM chains use free public RPCs (publicnode, ankr, llamarpc, blastapi).
# Non-EVM chains use their respective public APIs.
# No private keys needed for read-only indexing.

# ── 18. External Data Sources (ANIMA — AUDIT-4 Gap 1 + AUDIT-1 coverage) ─────
# These endpoints power the cross-plane data fetchers required by:
#   - BC  (Biological Capital)         → core/extended/biological_capital.py
#   - XSL (Cross-Species Liquidity)     → core/extended/cross_species.py
#   - SBA (Sovereign Behavioral Asset)  → core/extended/sovereign_behavioral.py
#   - ANIMA academic source            → anima-service/anima_engine.py (arXiv)
#
# Falsifiability conditions (WP2 §20):
#   F9  — BC scores validated against peer-reviewed valuations (IUCN).
#   F10 — XSL early-warning precedes species decline (IUCN + GBIF ground truth).
#   F11 — SBA accuracy vs IMF/World Bank composites over 24-month rolling window.
#
# All URLs default to the public free tiers. Override only for paid/pro
# tiers or private mirrors. Each fetcher reads its URL + token from these
# vars at startup. Rate-limit headers (X-RateLimit-Remaining etc.) are
# honored by the ANIMA fetcher pool — see EXTERNAL_API_RATE_LIMIT_PER_MIN.

# IUCN Red List API — token required for production (free, register at
# https://apiv3.iucnredlist.org/api/v3/account). Without a token, the
# fetcher degrades to the public unauthenticated endpoints with stricter
# rate limits (≈ 1 req/sec).
IUCN_API_URL=https://apiv3.iucnredlist.org/api/v3
IUCN_API_TOKEN=

# GBIF (Global Biodiversity Information Facility) — occurrence data API.
# Public, no token required. The species/occurrence/table endpoints are
# used to compute cross-species behavioral liquidity (XSL).
GBIF_API_URL=https://api.gbif.org/v1
GBIF_API_TOKEN=

# IMF DataMapper API — sovereign credit, GDP, debt-to-GDP, inflation composites.
# Used by SBA (Sovereign Behavioral Asset) for F11 falsifiability cross-check.
IMF_API_URL=https://www.imf.org/external/datamapper/api/v1
IMF_API_TOKEN=

# World Bank Open Data API — sovereign macro indicators (GDP, inflation,
# current-account balance, etc.). Public, no token required.
WORLD_BANK_API_URL=https://api.worldbank.org/v2
WORLD_BANK_API_TOKEN=

# arXiv API — academic preprints (cs.CR + q-fin.TR categories).
# Used by ANIMA's academic source credibility fetcher.
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_MAX_RESULTS=50
ARXIV_FETCH_INTERVAL_SEC=1800   # 30-minute TTL (matches ANIMA arxiv_ttl)

# Rate-limit / timeout tuning for ALL external data fetchers. These are
# read by anima-service/fetcher_pool.py (or fallback to defaults below).
# Per-source overrides take precedence; this is the global ceiling.
EXTERNAL_API_TIMEOUT=30                  # seconds per request
EXTERNAL_API_RATE_LIMIT_PER_MIN=60       # global request budget across sources
EXTERNAL_API_RETRY_MAX=3
EXTERNAL_API_RETRY_BACKOFF_BASE=2        # exponential: 2s, 4s, 8s

# ============================================================================
# EXTERNAL DATA SOURCE ENDPOINTS (all public, no API keys needed)
# ============================================================================

# ANIMA Intelligence — External Data Sources
ANIMA_GITHUB_API=https://api.github.com
ANIMA_GITHUB_REPO=dev-analyshd/trion-core
ANIMA_NEWS_FEEDS=coindesk,cointelegraph,theblock,decrypt,cryptoslate,bitcoinmagazine
ANIMA_SEC_EDGAR_URL=https://efts.sec.gov/LATEST/search-index
ANIMA_ARXIV_URL=http://export.arxiv.org/api/query
ANIMA_GBIF_URL=https://api.gbif.org/v1
ANIMA_IUCN_URL=https://apiv3.iucnredlist.org
ANIMA_IMF_URL=https://api.imf.org/external/sdmx/2.1
ANIMA_WORLDBANK_URL=https://api.worldbank.org/v2

# Multilingual NLP (10 languages: en,zh,ja,ko,es,fr,de,ru,ar,pt)
ANIMA_NLP_LANGUAGES=en,zh,ja,ko,es,fr,de,ru,ar,pt

# ============================================================================
# PUBLIC BLOCKCHAIN RPC ENDPOINTS (no API keys — public mainnet)
# ============================================================================

# EVM Chains (66 chains in registry)
ETH_RPC_URL=https://eth.llamarpc.com
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
OP_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com
BNB_RPC_URL=https://bsc-dataseed.binance.org
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# SVM (Solana)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Cosmos Chains (20 chains in registry)
COSMOS_HUB_RPC_URL=https://rpc.cosmos.directory/cosmoshub
OSMOSIS_RPC_URL=https://rpc.osmosis.zone

# Move Chains
APTOS_RPC_URL=https://fullnode.mainnet.aptoslabs.com
SUI_RPC_URL=https://fullnode.mainnet.sui.io

# Other VMs
NEAR_RPC_URL=https://rpc.mainnet.near.org
TON_RPC_URL=https://toncenter.com/api/v2/jsonRPC
STELLAR_RPC_URL=https://horizon.stellar.org

# ============================================================================
# DATABASE & STORAGE
# ============================================================================
DATABASE_URL=file:./db/custom.db
TIMESCALEDB_URL=
ZG_STORAGE_NODE=http://0g-storage-network-rpc.example.com

# ============================================================================
# SECURITY
# ============================================================================
# Post-Quantum Cryptography (optional — install kyber-py, dilithium-py, pyspx)
PQC_ENABLED=false
PQC_SECURITY_LEVEL=3

# Validator (optional — enable for mainnet consensus)
TRION_ENABLE_VALIDATOR=0
VALIDATOR_PRIVATE_KEY=

# ── PHASE-1-SECURITY: cross-VM bridge test keys ────────────────────────────
# Previously hard-coded in run_crossvm_zero_bridge.py and tests/crossvm/*.
# Now REQUIRED from environment for those scripts to run.
# Use dedicated testnet wallets; NEVER reuse for mainnet.
EVM_PRIVATE_KEY=                      # 0x… hex EVM private key (testnet wallet)
SOLANA_PRIVATE_KEY_B58=               # base58 Solana keypair (testnet wallet)

# ═══════════════════════════════════════════════════════════════════════════
# FULL-COMPLETION ADDITIONS (v2.1) — new indexers, modules, and services
# ═══════════════════════════════════════════════════════════════════════════

# ── New Rust indexers (fully implemented — XRPL / Waves / VeChain / MultiversX / Hedera) ──
XRPL_RPC_URL=https://s1.ripple.com:51234
WAVES_RPC_URL=https://nodes.wavesnodes.com
VECHAIN_RPC_URL=https://mainnet.vechain.org
MULTIVERSX_API_URL=https://api.multiversx.com
HEDERA_RPC_URL=https://mainnet.hashio.io/api

# ── BH streamer control (auto-start gate; 0 disables in tests) ──
TRION_ENABLE_STREAMER=1

# ── New Solidity: BTCPGasAbstraction.sol (Gap A — gas abstraction layer) ──
BTCP_GAS_ABSTRACTION_ADDR=

# ── Indexer poll intervals (ms) ──
POLL_MS=6000

# ══════════════════════════════════════════════════════════════════════════════
# ANIMA EXTERNAL INTELLIGENCE (Phase 3 wiring — real data sources)
# ══════════════════════════════════════════════════════════════════════════════

# Go validator mesh → Python ANIMA service delegation (crawler_pool.crawlLanguage)
ANIMA_SERVICE_URL=http://127.0.0.1:8000

# SEC EDGAR (free, no key — UA must include a contact email per SEC policy)
SEC_EDGAR_UA=TRION-Oracle/1.0 (contact@trion.network)
# SEC submissions API per-CIK fetching (rate limit 10 req/s, no key)

# GDELT DOC API (free, no key, 65+ languages — RATE LIMITED: 1 req / 5 s)
# https://api.gdeltproject.org/api/v2/doc/doc
GDELT_ENABLED=1

# StackExchange API (free, no key — forums crawler)
# https://api.stackexchange.com/2.3
STACKEXCHANGE_ENABLED=1

# Hacker News Algolia API (free, no key — forums crawler)
# https://hn.algolia.com/api/v1

# GBIF Occurrence API (free, no key — BC/XSL ecological calibration)
# https://api.gbif.org/v1

# IUCN Red List API (optional direct threat data — free token:
# https://apiv3.iucnredlist.org/api/v3/token)
IUCN_API_TOKEN=

# GitHub API (anonymous works at low rate; token lifts to 5000 req/h)
GITHUB_TOKEN=

# Regulatory RSS feeds (all free, no keys):
#   CFTC: https://www.cftc.gov/RSS/RSSGP/rssgp.xml
#   FCA:  https://www.fca.org.uk/news/rss.xml
#   ESMA: https://www.esma.europa.eu/press-news/esma-news/rss  (UA-gated)
#   MAS:  https://www.mas.gov.sg/news/rss
