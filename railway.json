{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "/app/railway-entrypoint.sh",
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  },
  "environments": {
    "production": {
      "PORT": "${{PORT}}",
      "FLASK_PORT": "5000",
      "FAISS_PORT": "8000",
      "FAISS_SERVICE_URL": "http://127.0.0.1:8000",
      "FAISS_URL": "http://127.0.0.1:8000",
      "ORACLE_API_URL": "http://127.0.0.1:5000",
      "FLASK_URL": "http://127.0.0.1:5000",
      "HOSTNAME": "0.0.0.0",
      "NODE_ENV": "production",
      "PYTHONUNBUFFERED": "1",
      "PYTHONDONTWRITEBYTECODE": "1",
      "TRION_ENABLE_STREAMER": "1",
      "TRION_MAX_CHAINS": "12",
      "TRION_ENABLE_VALIDATOR": "0",
      "TRION_ENABLE_SIGNAL_PROCESSING": "0",
      "DATABASE_URL": "",
      "TIMESCALEDB_URL": "",
      "BH_LEDGER_DB": "/app/bh_ledger.db"
    }
  }
}
