[Unit]
Description=TRION Protocol Oracle API Server (Flask + flask-socketio)
After=network.target trion-faiss.service
Requires=trion-faiss.service

[Service]
Type=simple
User=trion
WorkingDirectory=/opt/trion
Environment=PYTHONPATH=/opt/trion:/opt/trion/pylibs
Environment=FLASK_ENV=production
Environment=PORT=5000
Environment=FAISS_SERVICE_URL=http://127.0.0.1:8000
# serve.py = Flask + flask-socketio push layer: REST API on :5000 plus the
# /socket.io/ websocket (/feed namespace) that nginx proxies and the
# dashboard's live signal feed consumes. The REST-only alternative is
# `gunicorn --workers 4 --bind 127.0.0.1:5000 api.app:app` — it does NOT
# serve the websocket.
# (The old VALIDATOR_URL env is gone: nothing in the API reads it.)
ExecStart=/usr/bin/python3 serve.py
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trion/data /opt/trion/logs
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
