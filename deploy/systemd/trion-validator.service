[Unit]
Description=TRION Protocol Validator (Go) — long-running DW-BFT mesh daemon
Documentation=https://github.com/dev-analyshd/trion-core/blob/main/validator/README.md
After=network.target

[Service]
# The Go validator now runs as a long-lived daemon: the P2P mesh on :6000
# (internal/p2p/gateway.go), the TRION-BFT consensus engine
# (internal/consensus/engine.go), and the canonical certificate producer
# (internal/consensus/certificate_producer.go) all run inside this one
# binary. systemd restarts it on any unexpected exit so the validator stays
# in the mesh across reboots and crashes.
#
# Build it first on a machine with a Go >=1.21 toolchain:
#
#   cd /opt/trion/validator && \
#       go build -o /usr/local/bin/trion-validator ./cmd/trion-validator/
#
# (The previous ExecStart ran `python3 -m validator.node`, a module that has
# never existed — validator/ is pure Go.)
Type=simple
User=trion
WorkingDirectory=/opt/trion
ExecStart=/usr/local/bin/trion-validator --mesh :6000 --consensus --cert-producer
Restart=always
RestartSec=5s
TimeoutStartSec=120

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trion/data /opt/trion/logs
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
