[Unit]
Description=TRION Protocol Frontend Dashboard
After=network.target trion-api.service

[Service]
Type=simple
User=trion
WorkingDirectory=/opt/trion/frontend
# Build first: cd /opt/trion/frontend && npm ci && npm run build — Next.js
# `output: 'standalone'` (frontend/next.config.js) emits the self-contained
# server at .next/standalone/server.js (running `node server.js` from the
# frontend root never worked: there is no server.js there).
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=FLASK_URL=http://127.0.0.1:5000
Environment=NEXT_PUBLIC_API_URL=https://trion.example.com/api
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/trion/frontend/.next /opt/trion/logs
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
