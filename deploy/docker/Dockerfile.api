# TRION Protocol — API Server Dockerfile
FROM python:3.10-slim

LABEL org.opencontainers.image.title="TRION Oracle API"
LABEL org.opencontainers.image.description="TRION Protocol Behavioral Oracle API Server"
LABEL org.opencontainers.image.vendor="TRION Protocol"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
# (there is no root requirements.txt — the manifest lives in api/)
COPY api/requirements.txt ./api/requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt

# Copy application
COPY api/ ./api/
COPY core/ ./core/
COPY zk/ ./zk/
COPY adapters/ ./adapters/
COPY config/ ./config/
COPY scripts/ ./scripts/
# app.py registers the 0G routes from ../zg/zg_api_routes.py at boot
COPY zg/ ./zg/
# serve.py = Flask + flask-socketio push layer (api/socket_push.py)
COPY serve.py ./serve.py

# Create data and logs directories
RUN mkdir -p /app/data /app/logs
# The Flask app and the in-process BH streamer open the ledger at the
# repo-root path (/app/bh_ledger.db, cwd-relative in api/app.py + serve.py's
# init guard). Symlink it onto the /app/data volume so compose/systemd can
# persist and share the live ledger with the FAISS service (mounted at
# /app/data there too, BH_LEDGER_DB=/app/data/bh_ledger.db). sqlite follows
# the symlink and creates the file inside the volume on first write.
RUN ln -s data/bh_ledger.db /app/bh_ledger.db

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:5000/api/v1/health || exit 1

EXPOSE 5000

ENV PYTHONPATH=/app
ENV FLASK_PORT=5000
ENV PORT=5000

# serve.py runs the Flask app wrapped with flask-socketio (websocket push of
# new signal-feed entries + health packets on the /feed namespace — the
# nginx config proxies /socket.io/ here). The REST-only alternative is
# `gunicorn --workers 4 --bind 0.0.0.0:5000 api.app:app`, which does NOT
# serve the websocket.
CMD ["python3", "serve.py"]
