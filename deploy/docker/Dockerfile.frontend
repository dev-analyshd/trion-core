# TRION Protocol — Frontend Dashboard Dockerfile
FROM node:20-alpine AS builder

LABEL org.opencontainers.image.title="TRION Frontend"
LABEL org.opencontainers.image.description="TRION Protocol Dashboard Frontend"
LABEL org.opencontainers.image.vendor="TRION Protocol"

WORKDIR /app

# Install dependencies
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund

# Copy source and build
COPY frontend/ ./
RUN npm run build

# Runtime stage
FROM node:20-alpine

WORKDIR /app

# Next.js `output: 'standalone'` (frontend/next.config.js) emits a
# self-contained server at .next/standalone/server.js — copy that plus the
# static assets and public dir it serves. `node server.js` from a plain
# `.next` output would not work.
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# Install curl for health check
RUN apk add --no-cache curl

# The Next.js app exposes /healthz and /readyz route handlers (not /health).
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:3000/healthz || exit 1

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "server.js"]
