      "description": "TRION internal chain ID",
      "endian": "big"
    },
    {
      "name": "block_hash",
      "offset": 61,
      "length": 32,
      "type": "bytes",
      "description": "Block hash from chain header (32 bytes)",
      "endian": "big"
    }
  ],
  "dual_strand_hashing": {
    "algorithm": "SHA3-256",
    "sense": "SHA3-256(payload || 0x00)",
    "antisense": "SHA3-256(payload || 0xFF) XOR NOT(sense)",
    "invariant": "sense XOR antisense == NOT(SHA3-256(payload || 0xFF))",
    "complement_transform": "bitwise NOT (b ^ 0xFF for each byte)"
  },
