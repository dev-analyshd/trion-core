      "endian": "big"
    },
    {
      "name": "event_type",
      "offset": 32,
      "length": 1,
      "type": "uint8",
      "description": "Canonical event type ID (0-19)",
      "endian": "big"
    },
    {
      "name": "magnitude_nano",
      "offset": 33,
      "length": 8,
      "type": "uint64",
      "description": "Magnitude normalized to [0,1] × 1e9 (nano-scale fixed-point)",
      "endian": "big"
    },
    {
      "name": "context",
      "offset": 41,
      "length": 8,
      "type": "uint64",
      "description": "Context flags (bits 0-1: venue, bits 2-3: settlement, bits 4-7: reserved)",
      "endian": "big"
    },
    {
      "name": "timestamp_secs",
      "offset": 49,
      "length": 8,
      "type": "uint64",
      "description": "Unix timestamp in seconds",
      "endian": "big"
