# TRION Protocol Deployment Configuration
# =====================================

# Service Ports
FAISS_PORT=8000
API_PORT=5000
VALIDATOR_PORT=6000
FRONTEND_PORT=3000

# Python path (for environments with restricted system pip) — set TRION_EXTRA_PYTHONPATH instead
PYTHONPATH=

# Chain Configuration
CHAIN_ID=421614
NETWORK=arbitrum-sepolia
ORACLE_ADDRESS=0x1d129D34279d1246aB08a41dfE610EaF8D794237
VAULT_ADDRESS=0x7cB424b88E0b3fEd0DD5d626f4E413c6D0aAe73d

# External Service URLs
FAISS_SERVICE_URL=http://127.0.0.1:8000
FLASK_URL=http://127.0.0.1:5000

# Bootstrap Configuration
SIGMA_BOOTSTRAP=0.25
K_BOOTSTRAP=0.10
ANIMA_BOOTSTRAP=0.28
THETA_MIN=0.55
THETA_MAX=0.92

# Security
GK_EVOLUTION_INTERVAL=100
CRISPR_LIBRARY_SIZE=4

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
