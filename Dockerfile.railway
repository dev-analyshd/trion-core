# =============================================================================
# TRION Protocol — Railway Dockerfile v11.0  (ALL languages, ALL components)
# =============================================================================
#
# Builds and deploys EVERY TRION component in a single container:
#   - Flask Oracle API + Frontend (serve.py on $PORT — public)
#   - FAISS ANIMA Engine (port 8000)
#   - BH Streamer (real-time behavioral hash ingestion)
#   - 24 Rust indexers (compiled, supervisor-started)
#   - Go validator mesh (compiled, self-test on startup)
#   - C++ FFT signal processing (compiled, self-test on startup)
#   - Haskell formal verification (compiled, 9-theorem self-test)
#   - Julia math module (installed, self-test on startup)
#   - All smart contract source: Solidity, Cairo, Clarity, Soroban, Anchor,
#     Move, FunC, ink!, Vyper, CosmWasm
#
# Build: docker build -f Dockerfile.railway -t trion-protocol .
# Run:   docker run -p 10000:10000 -e PORT=10000 trion-protocol
# =============================================================================

FROM python:3.11-slim

LABEL maintainer="TRION Protocol"
LABEL description="TRION Protocol - Full Railway deployment with ALL languages"
LABEL org.opencontainers.image.source="https://github.com/dev-analyshd/trion-core"
LABEL version="11.0.0"

# ── System: ALL language toolchains in one image ────────────────────────────
# Rust (via rustup), Go, C++ (gcc/cmake), Haskell (via stack), Julia,
# Node.js (for SDK/relayer scripts), sqlite3, git, build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl bash tini ca-certificates gnupg libssl3 libpq5 \
        gcc g++ python3-dev cmake pkg-config \
        golang-go sqlite3 git xz-utils \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && . "$HOME/.cargo/env" \
    && rustup target add wasm32-unknown-unknown \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

# ── Install Haskell (stack) ──────────────────────────────────────────────────
RUN curl -sSL https://get.haskellstack.org/ | sh

# ── Install Julia ───────────────────────────────────────────────────────────
RUN curl -sSL https://julialang-s3.julialang.org/bin/linux/x64/1.9/julia-1.9.4-linux-x86_64.tar.gz \
    | tar -xzf - -C /opt/ && ln -s /opt/julia-1.9.4/bin/julia /usr/local/bin/julia

WORKDIR /app

# ── Python dependencies ──────────────────────────────────────────────────────
COPY api/requirements.txt ./api/requirements.txt
COPY anima-service/requirements.txt ./anima-service/requirements.txt
COPY pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir \
    -r api/requirements.txt \
    -r anima-service/requirements.txt \
    numpy scipy scikit-learn gunicorn web3 eth-account feedparser vaderSentiment \
    flask-cors apscheduler langdetect psycopg2-binary hypothesis ecdsa pynacl \
    flask-socketio simple-websocket requests faiss-cpu \
    && pip install --no-cache-dir --no-deps pynacl==1.6.2

# ── Application source (ALL directories) ─────────────────────────────────────
COPY api/             ./api/
COPY anima-service/   ./anima-service/
COPY core/            ./core/
COPY zk-circuits/     ./zk-circuits/
COPY adapters/        ./adapters/
COPY relayer/         ./relayer/
COPY chains/          ./chains/
COPY contracts/       ./contracts/
COPY supervisors/     ./supervisors/
COPY scripts/         ./scripts/
COPY config/          ./config/
COPY shared/          ./shared/
COPY math/            ./math/
COPY sdk/             ./sdk/
COPY serve.py         ./serve.py
COPY main.py          ./main.py
COPY zg/              ./zg/
COPY schema.sql       ./schema.sql
COPY package.json     ./package.json
COPY tsconfig.json    ./tsconfig.json

# ── All language source directories ──────────────────────────────────────────
COPY rust/            ./rust/
COPY indexers/        ./indexers/
COPY validator/       ./validator/
COPY signal-processing/ ./signal-processing/
COPY formal/          ./formal/
COPY hardhat/         ./hardhat/
COPY backtest/        ./backtest/
COPY deploy/          ./deploy/
COPY docs/            ./docs/
COPY akashic/         ./akashic/
COPY network/         ./network/
COPY spec/            ./spec/
COPY reports/         ./reports/
COPY btc-tools/       ./btc-tools/
COPY evm-tools/       ./evm-tools/

# ── Build Rust indexers (24 crates) ─────────────────────────────────────────
RUN cd /app/indexers && cargo build --release 2>&1 | tail -5 || echo "Rust build: some crates may need network deps"

# ── Build Go validator mesh ──────────────────────────────────────────────────
RUN cd /app/validator && go build ./... 2>&1 | tail -3 || echo "Go build: warning"

# ── Build C++ signal processing ──────────────────────────────────────────────
RUN cd /app/signal-processing && mkdir -p build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Release 2>&1 | tail -3 && make -j2 2>&1 | tail -3 || echo "C++ build: warning"

# ── Build Haskell formal verification ────────────────────────────────────────
RUN cd /app/formal && stack init 2>/dev/null; stack build 2>&1 | tail -5 || echo "Haskell build: warning"

# ── Build Soroban (Stellar) contracts to WASM ──────────────────────────────
RUN cd /app/contracts/soroban && cargo build --target wasm32-unknown-unknown 2>&1 | tail -3 || echo "Soroban build: warning"

# ── Build Solana (Anchor) contracts ──────────────────────────────────────────
RUN cd /app/contracts/solana && cargo build 2>&1 | tail -3 || echo "Solana build: warning"

# ── Deployment scripts ────────────────────────────────────────────────────────
COPY scripts/init_bh_ledger.py    ./scripts/init_bh_ledger.py
COPY scripts/deploy_preflight.py   ./scripts/deploy_preflight.py
RUN chmod +x ./scripts/init_bh_ledger.py ./scripts/deploy_preflight.py

# Pre-create the bh_ledger schema at build time
RUN python3 /app/scripts/init_bh_ledger.py 2>/dev/null || echo "BH ledger init (non-fatal)"

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY railway-entrypoint.sh ./railway-entrypoint.sh
RUN chmod +x ./railway-entrypoint.sh

# Runtime dirs
RUN mkdir -p /tmp/trion-logs anima-service/data /app/akashic /app/data

# ── Environment ───────────────────────────────────────────────────────────────
ENV HOSTNAME=0.0.0.0 \
    PYTHONPATH=/app \
    FAISS_PORT=8000 \
    FLASK_PORT=5000 \
    FAISS_SERVICE_URL=http://127.0.0.1:8000 \
    FAISS_URL=http://127.0.0.1:8000 \
    ORACLE_API_URL=http://127.0.0.1:${PORT:-10000} \
    FLASK_URL=http://127.0.0.1:${PORT:-10000} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRION_ENABLE_STREAMER=1 \
    TRION_MAX_CHAINS=12 \
    TRION_ENABLE_VALIDATOR=1 \
    TRION_ENABLE_SIGNAL_PROCESSING=1 \
    TRION_ENABLE_RUST_INDEXERS=1 \
    TRION_ENABLE_HASKELL_VERIFY=1 \
    TRION_ENABLE_JULIA_MATH=1 \
    DATABASE_URL="" \
    TIMESCALEDB_URL="" \
    BH_LEDGER_DB="/app/bh_ledger.db" \
    FAISS_API_KEY="trion-railway-key" \
    PORT=10000

EXPOSE 10000

# Healthcheck: serve.py serves on $PORT. /healthz is liveness (always 200).
HEALTHCHECK --interval=30s --timeout=15s --start-period=180s --retries=5 \
    CMD curl -fs http://localhost:${PORT:-10000}/healthz || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/railway-entrypoint.sh"]
