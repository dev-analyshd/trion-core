# =============================================================================
# TRION Protocol — Railway Dockerfile v12.0  (LEAN BUILD, ALL toolchains)
# =============================================================================
#
# v12.0 CHANGE LOG — fixes Railway deployment failure:
#   ROOT CAUSE: v11.0 ran 6 expensive compile-time builds (cargo --release for
#   24 crates with LTO+codegen-units=1, Haskell stack build, go build, cmake,
#   Soroban wasm, Solana) which exceeded Railway's build timeout + memory.
#   The `cmd | tail -N || echo warning` pattern also silently masked failures.
#
#   FIX: Keep ALL 6 language toolchains installed (Rust, Go, C++, Haskell,
#   Julia, Node) so runtime self-tests can still run, but SKIP every
#   compile-time build. The entrypoint already treats every non-Python
#   component as best-effort (`|| warn`), so missing binaries are logged
#   and skipped — they do NOT affect the /healthz healthcheck.
#
#   ONLY THE PYTHON SERVICE IS ON THE CRITICAL PATH:
#     - serve.py  (Flask + SocketIO on $PORT — public, healthchecked)
#     - faiss_service  (port $FAISS_PORT — internal, used by serve.py)
#
#   Build time: ~5 min (was ~45 min). Build memory: ~2 GB (was ~8 GB).
#
# Build: docker build -f Dockerfile.railway -t trion-protocol .
# Run:   docker run -p 10000:10000 -e PORT=10000 trion-protocol
# =============================================================================

FROM python:3.11-slim

LABEL maintainer="TRION Protocol"
LABEL description="TRION Protocol - Lean Railway deployment with ALL toolchains"
LABEL org.opencontainers.image.source="https://github.com/dev-analyshd/trion-core"
LABEL version="12.0.0"

# ── System: ALL language toolchains in one image (NO compilation at build) ───
# Rust (via rustup), Go, C++ (gcc/cmake), Haskell (stack binary only),
# Node.js 20 (for SDK/relayer scripts), sqlite3, git, build tools.
# NOTE: we intentionally do NOT add the wasm32 target — Soroban/Solana contract
# builds are skipped (see CHANGE LOG above). Runtime self-tests handle absence.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl bash tini ca-certificates gnupg libssl3 libpq5 \
        gcc g++ python3-dev cmake pkg-config \
        golang-go sqlite3 git xz-utils \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
        --default-toolchain stable --profile minimal \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && curl -sSL https://get.haskellstack.org/ | sh \
    && curl -sSL https://julialang-s3.julialang.org/bin/linux/x64/1.9/julia-1.9.4-linux-x86_64.tar.gz \
        | tar -xzf - -C /opt/ && ln -s /opt/julia-1.9.4/bin/julia /usr/local/bin/julia \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.cargo/registry /root/.cargo/git

ENV PATH="/root/.cargo/bin:/opt/julia-1.9.4/bin:${PATH}"

WORKDIR /app

# ── Python dependencies (the ONLY critical build step) ──────────────────────
COPY api/requirements.txt ./api/requirements.txt
COPY anima-service/requirements.txt ./anima-service/requirements.txt
COPY pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir \
        -r api/requirements.txt \
        -r anima-service/requirements.txt \
        numpy scipy scikit-learn gunicorn web3 eth-account feedparser vaderSentiment \
        flask-cors apscheduler langdetect psycopg2-binary hypothesis ecdsa pynacl \
        flask-socketio simple-websocket requests faiss-cpu \
    && pip install --no-cache-dir --no-deps pynacl==1.6.2

# ── Application source (ALL directories) ─────────────────────────────────────
COPY api/             ./api/
COPY anima-service/   ./anima-service/
COPY core/            ./core/
COPY zk-circuits/     ./zk-circuits/
COPY adapters/        ./adapters/
COPY relayer/         ./relayer/
COPY chains/          ./chains/
COPY contracts/       ./contracts/
COPY supervisors/     ./supervisors/
COPY scripts/         ./scripts/
COPY config/          ./config/
COPY shared/          ./shared/
COPY math/            ./math/
COPY sdk/             ./sdk/
COPY serve.py         ./serve.py
COPY main.py          ./main.py
COPY zg/              ./zg/
COPY schema.sql       ./schema.sql
COPY package.json     ./package.json
COPY tsconfig.json    ./tsconfig.json

# ── All language source directories (kept for runtime self-tests) ────────────
COPY rust/            ./rust/
COPY indexers/        ./indexers/
COPY validator/       ./validator/
COPY signal-processing/ ./signal-processing/
COPY formal/          ./formal/
COPY hardhat/         ./hardhat/
COPY backtest/        ./backtest/
COPY deploy/          ./deploy/
COPY docs/            ./docs/
COPY akashic/         ./akashic/
COPY network/         ./network/
COPY spec/            ./spec/
COPY reports/         ./reports/
COPY btc-tools/       ./btc-tools/
COPY evm-tools/       ./evm-tools/

# ── Build-time smoke test: Python imports MUST succeed (fail-closed) ────────
# This catches missing/incompatible pip deps BEFORE Railway tries to boot the
# container, instead of producing a crash-loop at runtime.
RUN python3 -c "\
import flask, flask_socketio, flask_cors, web3, numpy, scipy, sklearn, \
       faiss, apscheduler, vaderSentiment, feedparser, langdetect, \
       eth_account, nacl, requests, simple_websocket; \
print('BUILD-TIME SMOKE TEST: all core Python imports OK')"

# ── App-level import smoke test (catches broken internal modules) ───────────
RUN python3 -c "\
import sys; sys.path.insert(0, 'api'); \
import socket_push; \
print('BUILD-TIME SMOKE TEST: socket_push (Flask app) imports OK')"

# ── Deployment scripts + BH ledger schema init (fast, reliable) ─────────────
RUN chmod +x ./scripts/init_bh_ledger.py ./scripts/deploy_preflight.py 2>/dev/null || true
RUN python3 /app/scripts/init_bh_ledger.py 2>/dev/null || echo "BH ledger init (non-fatal)"

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY railway-entrypoint.sh ./railway-entrypoint.sh
RUN chmod +x ./railway-entrypoint.sh

# Runtime dirs
RUN mkdir -p /tmp/trion-logs anima-service/data /app/akashic /app/data

# ── Environment ───────────────────────────────────────────────────────────────
ENV HOSTNAME=0.0.0.0 \
    PYTHONPATH=/app \
    FAISS_PORT=8000 \
    FLASK_PORT=5000 \
    FAISS_SERVICE_URL=http://127.0.0.1:8000 \
    FAISS_URL=http://127.0.0.1:8000 \
    ORACLE_API_URL=http://127.0.0.1:${PORT:-10000} \
    FLASK_URL=http://127.0.0.1:${PORT:-10000} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRION_ENABLE_STREAMER=1 \
    TRION_MAX_CHAINS=12 \
    TRION_ENABLE_VALIDATOR=1 \
    TRION_ENABLE_SIGNAL_PROCESSING=1 \
    TRION_ENABLE_RUST_INDEXERS=1 \
    TRION_ENABLE_HASKELL_VERIFY=1 \
    TRION_ENABLE_JULIA_MATH=1 \
    DATABASE_URL="" \
    TIMESCALEDB_URL="" \
    BH_LEDGER_DB="/app/bh_ledger.db" \
    FAISS_API_KEY="trion-railway-key" \
    PORT=10000

EXPOSE 10000

# Healthcheck: serve.py serves on $PORT. /healthz is liveness (always 200).
HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=5 \
    CMD curl -fs http://localhost:${PORT:-10000}/healthz || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/railway-entrypoint.sh"]
