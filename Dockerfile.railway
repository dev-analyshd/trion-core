# =============================================================================
# TRION Protocol — Railway Dockerfile  (Full-stack capable, default lightweight)
# =============================================================================
#
# DEFAULT: Lightweight mode for Railway free/hobby tier:
#   - Core: Flask + FAISS + BH Streamer + Next.js
#   - All source code included (Rust, Go, C++, Haskell, Julia, Solidity, Vyper)
#   - Optional services disabled by default (enable via env vars)
#
# OPTIONAL SERVICES (set env var to 1 to enable):
#   TRION_ENABLE_VALIDATOR=1       — Go P2P validator network (port 6000)
#   TRION_ENABLE_INDEXERS=1        — Rust indexer binaries (if built)
#   TRION_ENABLE_SIGNAL_PROCESSING=1 — C++ signal processing engine
#   TRION_ENABLE_MONITORING=1      — Prometheus + Grafana
#
# FULL STACK BUILD (heavier, longer build):
#   docker build --build-arg TRION_FULL_STACK=1 -f Dockerfile.railway .
#   Installs Rust + Haskell toolchains for native compilation
#
# Build time (default): ~5 minutes | Image size: ~800MB
# Build time (full stack): ~20+ minutes | Image size: ~2GB+
# =============================================================================

# ─── Stage 1: Build Next.js frontend ─────────────────────────────────────────
# Build timestamp arg — rebuild frontend when code changes (--build-arg BUILD_TIMESTAMP=$(date +%s))
ARG BUILD_TIMESTAMP=unknown
FROM node:20-slim AS next-builder

WORKDIR /build

# Copy frontend package.json and install deps
COPY frontend/package.json frontend/package-lock.json* ./
# Force cache invalidation on new builds
ENV BUILD_TIMESTAMP=1787199600
RUN npm install --legacy-peer-deps --silent

# Copy frontend source
COPY frontend/ ./

# Build Next.js standalone
ENV NEXT_PUBLIC_API_BASE=""
ENV FLASK_URL="http://127.0.0.1:5000"
# CACHE BUST: Force rebuild when frontend source changes
RUN echo "Build timestamp: 1787199600" && echo "Source hash:" && find . -type f -name "*.tsx" -o -name "*.ts" -o -name "*.js" -o -name "*.json" | sort | xargs cat | sha256sum | head -c 16
RUN npm run build 2>&1 | tail -20

# Verify standalone output exists
RUN test -f /build/.next/standalone/server.js && echo "OK: standalone build" || { echo "FATAL: no standalone"; exit 1; }

# ─── Stage 2: Runtime (Python + Node.js) ────────────────────────────────────
FROM python:3.11-slim

LABEL maintainer="TRION Protocol"
LABEL description="TRION Protocol - Railway deployment"
LABEL org.opencontainers.image.source="https://github.com/dev-analyshd/trion-core"
LABEL version="6.0.0"

# ── System: Node.js 20, curl, tini, build tools ───────────────────────────────
# Optional full-stack build arg: set to 1 to install Rust/Haskell/Julia toolchains
ARG TRION_FULL_STACK=0

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl bash tini ca-certificates gnupg libssl3 libpq5 \
        gcc g++ python3-dev cmake pkg-config \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] \
       https://deb.nodesource.com/node_20.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Optional: Go and Julia runtimes (best-effort, don't fail build) ───────────
# These may not be available in Debian slim repos; install if available
RUN apt-get update \
    && apt-get install -y --no-install-recommends golang 2>/dev/null || echo "Go not available in repos" \
    && apt-get install -y --no-install-recommends julia 2>/dev/null || echo "Julia not available in repos" \
    && rm -rf /var/lib/apt/lists/* \
    && (command -v go && go version || true) \
    && (command -v julia && julia --version || true)

WORKDIR /app

# ── Next.js standalone build ─────────────────────────────────────────────────
COPY --from=next-builder /build/.next/standalone /app/frontend/
COPY --from=next-builder /build/.next/static /app/frontend/.next/static
COPY --from=next-builder /build/public /app/frontend/public

# ── Python dependencies ──────────────────────────────────────────────────────
COPY api/requirements.txt ./api/requirements.txt
COPY anima-service/requirements.txt ./anima-service/requirements.txt
RUN pip install --no-cache-dir \
    -r api/requirements.txt \
    -r anima-service/requirements.txt \
    numpy scipy scikit-learn gunicorn web3 eth-account feedparser vaderSentiment
# PHASE-1-SECURITY: force-upgrade pynacl (cosmpy transitively pins 1.6.0
# which has PYSEC-2026-3002). --no-deps avoids the cosmpy resolver conflict.
RUN pip install --no-cache-dir --no-deps pynacl==1.6.2

# ── Application source ───────────────────────────────────────────────────────
COPY api/             ./api/
COPY anima-service/   ./anima-service/
COPY core/            ./core/
COPY zk/              ./zk/
COPY adapters/        ./adapters/
# src/ was removed (deprecated shim layer) — all code is in core/
COPY relayer/         ./relayer/
COPY chains/          ./chains/
COPY trion-0g/        ./trion-0g/
COPY contracts/       ./contracts/
COPY supervisors/     ./supervisors/
COPY scripts/         ./scripts/
COPY config/          ./config/
COPY shared/          ./shared/
COPY math/            ./math/
COPY sdk/             ./sdk/
COPY proof-ledger/    ./proof-ledger/
COPY serve.py         ./serve.py
COPY main.py          ./main.py
COPY deployments.json ./deployments.json
COPY zg/              ./zg/
COPY schema.sql       ./schema.sql
COPY package.json     ./package.json
COPY tsconfig.json    ./tsconfig.json

# ── Additional source directories (all components, workflows, languages) ──
# Rust workspace (BTCP router, dispute resolution, intent aggregator, etc.)
COPY rust/            ./rust/
# Rust L0 indexer crates (16 crates, EVM + Bot Chain + extended VM)
COPY indexers/        ./indexers/
# Go P2P validator network
COPY validator/       ./validator/
# C++ FFT, sensor I/O, signal conditioning
COPY signal-processing/ ./signal-processing/
# Haskell formal verification (9 theorems)
COPY formal/          ./formal/
# Solidity dev environment
COPY hardhat/         ./hardhat/
# Backtesting framework
COPY backtest/        ./backtest/
# Production deployment configs
COPY deploy/          ./deploy/
# ARCHITECTURE.md, DEPLOYMENT.md
COPY docs/            ./docs/
# Akashic state storage
COPY akashic/         ./akashic/
# Continuum state machine
COPY continuum/       ./continuum/
# SVM (Solana) indexer + adapter (Rust + TS + Python)
COPY trion-svm/       ./trion-svm/
# Network health monitor (Go)
COPY network/         ./network/
# Formal specification documents
COPY spec/            ./spec/
# Runtime reports directory (created empty; populated at runtime)
COPY reports/         ./reports/

# ── BH ledger database initialization ────────────────────────────────────────
COPY scripts/init_bh_ledger.py ./scripts/init_bh_ledger.py
RUN python3 /app/scripts/init_bh_ledger.py 2>/dev/null || echo "BH ledger init skipped (non-fatal)"

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY railway-entrypoint.sh ./railway-entrypoint.sh
RUN chmod +x ./railway-entrypoint.sh

# Runtime dirs
RUN mkdir -p /tmp/trion-logs anima-service/data /app/akashic /app/data

# ── Environment ───────────────────────────────────────────────────────────────
# Note: PORT is injected by Railway at runtime — do NOT set it here as a static ENV.
# The entrypoint script reads PORT from the environment and defaults to 10000.
# Optional service toggles (default OFF — set TRION_ENABLE_*=1 to activate).
# Validator (Go), Rust indexers, C++ signal processing, Prometheus/Grafana.
ENV HOSTNAME=0.0.0.0 \
    PYTHONPATH=/app \
    FAISS_PORT=8000 \
    FLASK_PORT=5000 \
    FAISS_SERVICE_URL=http://127.0.0.1:8000 \
    FAISS_URL=http://127.0.0.1:8000 \
    ORACLE_API_URL=http://127.0.0.1:5000 \
    FLASK_URL=http://127.0.0.1:5000 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    TRION_ENABLE_FAISS=1 \
    TRION_ENABLE_RUST=0 \
    TRION_ENABLE_RELAYER=0 \
    TRION_ENABLE_ZG_SYNC=0 \
    TRION_ENABLE_ZG_DA=0 \
    TRION_ENABLE_EXTRAS=0 \
    TRION_ENABLE_NATIVE=0 \
    TRION_ENABLE_VALIDATOR=0 \
    TRION_ENABLE_INDEXERS=0 \
    TRION_ENABLE_SIGNAL_PROCESSING=0 \
    TRION_ENABLE_MONITORING=0 \
    TRION_VALIDATOR_PORT=6000 \
    TRION_PROMETHEUS_PORT=9090 \
    TRION_GRAFANA_PORT=3001 \
    DATABASE_URL="" \
    TIMESCALEDB_URL="" \
    BH_LEDGER_DB="/app/bh_ledger.db" \
    ZG_NETWORK=mainnet \
    ZG_CHAIN_ID=16661 \
    ZERO_G_RPC=https://evmrpc.0g.ai \
    ZG_EXECUTION_GATE_ADDR=0xA85B49C73B5710d9ddB1CB5a94c52D0F33c4199b

# Railway injects PORT at runtime. Default to 10000 for local docker runs.
EXPOSE 10000

# Shell form so ${PORT} (injected by Railway at runtime) is expanded by /bin/sh.
# Falls back to 10000 when PORT is unset (local docker run without env).
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
    CMD curl -fs http://localhost:${PORT:-10000}/api/v1/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/railway-entrypoint.sh"]
