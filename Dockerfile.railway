# =============================================================================
# TRION Protocol — Railway Dockerfile v8.0  (Full-stack, all components)
# =============================================================================
#
# Builds and deploys ALL TRION components:
#   - Flask Oracle API (port 5000)
#   - FAISS ANIMA Engine (port 8000)
#   - Next.js Frontend (port $PORT — public)
#   - BH Streamer (real-time behavioral hash ingestion)
#   - All source code: Python, Rust, Go, C++, Haskell, Julia, Solidity, Cairo
#
# Build: docker build -f Dockerfile.railway -t trion-protocol .
# Run:   docker run -p 10000:10000 -e PORT=10000 trion-protocol
#
# Build time: ~8 minutes | Image size: ~1.2GB
# =============================================================================

# ─── Stage 1: Build Next.js frontend ─────────────────────────────────────────
FROM node:20-slim AS next-builder

WORKDIR /build

# Copy frontend package.json and install deps
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --legacy-peer-deps --silent

# Copy frontend source
COPY frontend/ ./

# Build Next.js standalone
ENV NEXT_PUBLIC_API_BASE=""
ENV FLASK_URL="http://127.0.0.1:5000"
RUN npm run build 2>&1 | tail -20

# Verify standalone output exists
RUN test -f /build/.next/standalone/server.js && echo "OK: standalone build" || { echo "FATAL: no standalone"; exit 1; }

# ─── Stage 2: Runtime (Python + Node.js + all languages) ───────────────────
FROM python:3.11-slim

LABEL maintainer="TRION Protocol"
LABEL description="TRION Protocol - Full Railway deployment"
LABEL org.opencontainers.image.source="https://github.com/dev-analyshd/trion-core"
LABEL version="8.0.0"

# ── System: Node.js 20, curl, tini, build tools ───────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl bash tini ca-certificates gnupg libssl3 libpq5 \
        gcc g++ python3-dev cmake pkg-config \
        golang \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] \
       https://deb.nodesource.com/node_20.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Next.js standalone build ─────────────────────────────────────────────────
COPY --from=next-builder /build/.next/standalone /app/frontend/
COPY --from=next-builder /build/.next/static /app/frontend/.next/static
COPY --from=next-builder /build/public /app/frontend/public

# ── Python dependencies ──────────────────────────────────────────────────────
COPY api/requirements.txt ./api/requirements.txt
COPY anima-service/requirements.txt ./anima-service/requirements.txt
COPY pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir \
    -r api/requirements.txt \
    -r anima-service/requirements.txt \
    numpy scipy scikit-learn gunicorn web3 eth-account feedparser vaderSentiment \
    flask-cors apscheduler langdetect psycopg2-binary hypothesis ecdsa pynacl \
    && pip install --no-cache-dir --no-deps pynacl==1.6.2

# ── Application source (ALL directories) ─────────────────────────────────────
COPY api/             ./api/
COPY anima-service/   ./anima-service/
COPY core/            ./core/
COPY zk/              ./zk/
COPY zk-circuits/     ./zk-circuits/
COPY adapters/        ./adapters/
COPY relayer/         ./relayer/
COPY chains/          ./chains/
COPY trion-0g/        ./trion-0g/
COPY contracts/       ./contracts/
COPY supervisors/     ./supervisors/
COPY scripts/         ./scripts/
COPY config/          ./config/
COPY shared/          ./shared/
COPY math/            ./math/
COPY sdk/             ./sdk/
COPY proof-ledger/    ./proof-ledger/
COPY serve.py         ./serve.py
COPY main.py          ./main.py
COPY zg/              ./zg/
COPY schema.sql       ./schema.sql
COPY package.json     ./package.json
COPY tsconfig.json    ./tsconfig.json

# ── All language source directories ──────────────────────────────────────────
# Rust workspace (BTCP router, 19 spec modules, 94 tests)
COPY rust/            ./rust/
# Rust L0 indexer crates (21 chain crates)
COPY indexers/        ./indexers/
# Go P2P validator network
COPY validator/       ./validator/
# C++ FFT, sensor I/O, signal conditioning
COPY signal-processing/ ./signal-processing/
# Haskell formal verification (9 theorems)
COPY formal/          ./formal/
# Solidity dev environment (Hardhat)
COPY hardhat/         ./hardhat/
# Backtesting framework
COPY backtest/        ./backtest/
# Production deployment configs (Docker, Nginx, systemd)
COPY deploy/          ./deploy/
# Documentation
COPY docs/            ./docs/
# Akashic state storage
COPY akashic/         ./akashic/
# Continuum state machine
COPY continuum/       ./continuum/
# Network health monitor (Go)
COPY network/         ./network/
# Formal specification documents
COPY spec/            ./spec/
# Reports directory
COPY reports/         ./reports/
# BTC tools (zero-bridge test scripts)
COPY btc-tools/       ./btc-tools/
# EVM tools (Solidity compiler + deployers)
COPY evm-tools/       ./evm-tools/

# ── Deployment scripts ────────────────────────────────────────────────────────
COPY scripts/init_bh_ledger.py    ./scripts/init_bh_ledger.py
COPY scripts/deploy_preflight.py   ./scripts/deploy_preflight.py
RUN chmod +x ./scripts/init_bh_ledger.py ./scripts/deploy_preflight.py

# Pre-create the bh_ledger schema at build time
RUN python3 /app/scripts/init_bh_ledger.py 2>/dev/null || echo "BH ledger init (non-fatal)"

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY railway-entrypoint.sh ./railway-entrypoint.sh
RUN chmod +x ./railway-entrypoint.sh

# Runtime dirs
RUN mkdir -p /tmp/trion-logs anima-service/data /app/akashic /app/data

# ── Environment ───────────────────────────────────────────────────────────────
# NOTE: only toggles the railway entrypoint actually gates on are set here
# (TRION_ENABLE_STREAMER / _VALIDATOR / _SIGNAL_PROCESSING + TRION_MAX_CHAINS).
# TRION_ENABLE_FAISS/RUST/RELAYER/ZG_SYNC/ZG_DA/EXTRAS/NATIVE were removed —
# railway-entrypoint.sh has no sections for them in this OBSERVATION image
# (no relayer: it never reads RELAYER_PRIVATE_KEY / KMS_* here). The
# TRION_ENABLE_MONITORING and TRION_ENABLE_INDEXERS toggles were read by
# nothing anywhere and are gone.
ENV HOSTNAME=0.0.0.0 \
    PYTHONPATH=/app \
    FAISS_PORT=8000 \
    FLASK_PORT=5000 \
    FAISS_SERVICE_URL=http://127.0.0.1:8000 \
    FAISS_URL=http://127.0.0.1:8000 \
    ORACLE_API_URL=http://127.0.0.1:5000 \
    FLASK_URL=http://127.0.0.1:5000 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    TRION_ENABLE_STREAMER=1 \
    TRION_MAX_CHAINS=12 \
    TRION_ENABLE_VALIDATOR=0 \
    TRION_ENABLE_SIGNAL_PROCESSING=0 \
    DATABASE_URL="" \
    TIMESCALEDB_URL="" \
    BH_LEDGER_DB="/app/bh_ledger.db" \
    ZG_NETWORK=mainnet \
    ZG_CHAIN_ID=16661 \
    ZERO_G_RPC=https://evmrpc.0g.ai \
    ZG_EXECUTION_GATE_ADDR=0xA85B49C73B5710d9ddB1CB5a94c52D0F33c4199b

# Railway injects PORT at runtime. Default to 10000 for local docker runs.
EXPOSE 10000

# Healthcheck uses /readyz (not /api/v1/health) so the container is "healthy"
# only when the whole chain — Next.js → Flask → FAISS — is ready to serve.
HEALTHCHECK --interval=30s --timeout=15s --start-period=300s --retries=5 \
    CMD curl -fs http://localhost:${PORT:-10000}/readyz || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/railway-entrypoint.sh"]
