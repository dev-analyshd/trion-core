;; liquidity.fc — TRION TON Liquidity Commitment (TVM / FunC)
;;
;; Mirrors LiquidityOcean.sol + BTCP_ESCROW.vy on TON.
;; Commitment statuses: 0=PENDING 1=SETTLED 2=REVERTED
;; Revert reasons: 0=TIMEOUT 1=COHERENCE_FAILURE 2=ROUTE_INVALID 3=MANUAL
;;
;; Storage layout:
;;   owner_addr       (267 bits)
;;   commitment_count (64 bits)
;;   commitments_dict (dict, key=256-bit commitment_id, value=commitment cell ref)
;;
;; Commitment cell layout — split across 2 cells (TVM cells hold at most 1023
;; data bits; the old flat 1424-bit layout made end_cell() throw cell-overflow
;; on every commit, bricking the contract):
;;   ROOT cell (968 bits) — identity + value + status (all fields needed by
;;   the settle/revert guards and get_commitment — no ref traversal):
;;     entity_id    [256 bits]
;;     route_id     [256 bits]
;;     asset        [256 bits]
;;     amount       [64 bits]
;;     min_coherence[64 bits]
;;     expiry       [64 bits]
;;     status       [8 bits]
;;   REF 0 (456 bits) — lifecycle/settlement fields (needed to re-pack):
;;     created_at   [64 bits]
;;     execution_bh [256 bits]
;;     settled_at   [64 bits]
;;     revert_at    [64 bits]
;;     revert_code  [8 bits]
;;
;; Dict values are stored as a single ref to the record cell
;; (begin_cell().store_ref(rec).end_cell().begin_parse()), which matches the
;; load_ref() read pattern below and keeps dict node cells tiny.
;;
;; Op codes:
;;   0x01  commit_liquidity
;;   0x02  settle_commitment   (owner only)
;;   0x03  revert_commitment   (owner only)
;;   0x10  transfer_ownership
;;
;; Message bodies (first cell ≤ 1023 bits; senders build root + refs):
;;   0x01 commit: root = op[32] cid[256] entity[256] route[256] amount[64]
;;                     min_coh[64] expiry[64]                        (992 bits)
;;                ref 0 = asset[256]                                 (256 bits)
;;   0x02 settle:  op[32] cid[256] exec_bh[256] coherence[64]        (608 bits)
;;   0x03 revert:  op[32] cid[256] reason[8]                         (296 bits)
;;   0x10:         op[32] new_owner[267]                             (299 bits)

#include "stdlib.fc";

const int ERR_UNAUTHORIZED       = 100;
const int ERR_INVALID_SCORE      = 101;
const int ERR_COMMITMENT_EXISTS  = 130;
const int ERR_COMMITMENT_MISSING = 131;
const int ERR_ALREADY_FINAL      = 132;
const int ERR_EXPIRED            = 133;
const int ERR_COHERENCE_LOW      = 134;


;; ── Storage ───────────────────────────────────────────────────────────────────

(slice, int, cell) load_storage() inline {
    slice ds = get_data().begin_parse();
    slice owner_addr      = ds~load_bits(267);
    int commitment_count  = ds~load_uint(64);
    cell commitments_dict = ds~load_ref();
    return (owner_addr, commitment_count, commitments_dict);
}

() save_storage(slice owner_addr, int commitment_count, cell commitments_dict) impure inline {
    set_data(begin_cell()
        .store_slice(owner_addr)
        .store_uint(commitment_count, 64)
        .store_ref(commitments_dict)
    .end_cell());
}

;; Cell-overflow-safe layout (TVM limit: 1023 data bits / cell):
;;   root (968 bits) = entity, route, asset, amount, min_coh, expiry, status
;;   ref 0 (456 bits) = created_at, execution_bh, settled_at, revert_at,
;;                     revert_code

cell pack_commitment(
    int entity, int route, int asset, int amount, int min_coh, int expiry,
    int status, int ts, int exec_bh, int settled_at, int revert_at, int revert_code
) inline {
    cell tail = begin_cell()
        .store_uint(ts,            64)
        .store_uint(exec_bh,      256)
        .store_uint(settled_at,    64)
        .store_uint(revert_at,     64)
        .store_uint(revert_code,    8)
    .end_cell();
    return begin_cell()
        .store_uint(entity,       256)
        .store_uint(route,        256)
        .store_uint(asset,        256)
        .store_uint(amount,        64)
        .store_uint(min_coh,       64)
        .store_uint(expiry,        64)
        .store_uint(status,         8)
        .store_ref(tail)                   ;; 456-bit overflow cell
    .end_cell();
}

;; Unpacks the commitment record cell — returns the original flat field order
;; so call sites keep destructuring exactly as before.
(int, int, int, int, int, int, int, int, int, int, int, int) unpack_commitment(slice s) inline {
    int entity  = s~load_uint(256);
    int route   = s~load_uint(256);
    int asset   = s~load_uint(256);
    int amount  = s~load_uint(64);
    int min_coh = s~load_uint(64);
    int expiry  = s~load_uint(64);
    int status  = s~load_uint(8);
    slice tail  = s~load_ref().begin_parse();
    int ts      = tail~load_uint(64);
    int exec_bh = tail~load_uint(256);
    int settled = tail~load_uint(64);
    int rev_at  = tail~load_uint(64);
    int rcode   = tail~load_uint(8);
    return (entity, route, asset, amount, min_coh, expiry, status, ts,
            exec_bh, settled, rev_at, rcode);
}

;; ── recv_internal ─────────────────────────────────────────────────────────────

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { return (); }

    slice cs = in_msg_full.begin_parse();
    cs~load_uint(4);
    slice sender_addr = cs~load_bits(267);

    int op = in_msg_body~load_uint(32);

    ;; ── 0x01 commit_liquidity ────────────────────────────────────────────────
    if (op == 1) {
        (slice owner_addr, int ccount, cell cdict) = load_storage();

        int cid       = in_msg_body~load_uint(256);
        int entity    = in_msg_body~load_uint(256);
        int route     = in_msg_body~load_uint(256);
        int amount    = in_msg_body~load_uint(64);
        int min_coh   = in_msg_body~load_uint(64);
        int expiry    = in_msg_body~load_uint(64);
        ;; asset lives in the body's overflow ref (body root is 992 bits)
        slice cb      = in_msg_body~load_ref().begin_parse();
        int asset     = cb~load_uint(256);

        throw_if(ERR_INVALID_SCORE, min_coh > 1000000);

        slice ckey = begin_cell().store_uint(cid, 256).end_cell().begin_parse();
        (_, int found) = cdict.dict_get?(256, ckey);
        throw_if(ERR_COMMITMENT_EXISTS, found);

        int ts = now();
        throw_if(ERR_EXPIRED, expiry <= ts);

        cell cc = pack_commitment(entity, route, asset, amount, min_coh, expiry, 0, ts, 0, 0, 0, 0);
        ;; dict value = one ref to the record cell (matches load_ref reads)
        cdict~dict_set(256, ckey, begin_cell().store_ref(cc).end_cell().begin_parse());
        save_storage(owner_addr, ccount + 1, cdict);
        return ();
    }

    ;; ── 0x02 settle_commitment ───────────────────────────────────────────────
    if (op == 2) {
        (slice owner_addr, int ccount, cell cdict) = load_storage();
        throw_unless(ERR_UNAUTHORIZED, equal_slices(sender_addr, owner_addr));

        int cid      = in_msg_body~load_uint(256);
        int exec_bh  = in_msg_body~load_uint(256);
        int coherence = in_msg_body~load_uint(64);

        slice ckey = begin_cell().store_uint(cid, 256).end_cell().begin_parse();
        (slice cv, int found) = cdict.dict_get?(256, ckey);
        throw_unless(ERR_COMMITMENT_MISSING, found);

        cell cc = cv~load_ref();
        slice s = cc.begin_parse();
        int entity  = s~load_uint(256);
        int route   = s~load_uint(256);
        int asset   = s~load_uint(256);
        int amount  = s~load_uint(64);
        int min_coh = s~load_uint(64);
        int expiry  = s~load_uint(64);
        int status  = s~load_uint(8);
        ;; created_at lives in the overflow ref; the remaining tail fields are
        ;; rebuilt from this op's inputs, so only ts is read back
        slice tl  = s~load_ref().begin_parse();
        int ts    = tl~load_uint(64);

        throw_if(ERR_ALREADY_FINAL, status != 0);
        throw_if(ERR_EXPIRED, now() > expiry);
        throw_if(ERR_COHERENCE_LOW, coherence < min_coh);

        cell new_cc = pack_commitment(entity, route, asset, amount, min_coh, expiry, 1, ts, exec_bh, now(), 0, 0);
        ;; dict value = one ref to the record cell (matches load_ref reads)
        cdict~dict_set(256, ckey, begin_cell().store_ref(new_cc).end_cell().begin_parse());
        save_storage(owner_addr, ccount, cdict);
        return ();
    }

    ;; ── 0x03 revert_commitment ───────────────────────────────────────────────
    if (op == 3) {
        (slice owner_addr, int ccount, cell cdict) = load_storage();
        throw_unless(ERR_UNAUTHORIZED, equal_slices(sender_addr, owner_addr));

        int cid    = in_msg_body~load_uint(256);
        int reason = in_msg_body~load_uint(8);

        slice ckey = begin_cell().store_uint(cid, 256).end_cell().begin_parse();
        (slice cv, int found) = cdict.dict_get?(256, ckey);
        throw_unless(ERR_COMMITMENT_MISSING, found);

        cell cc = cv~load_ref();
        slice s = cc.begin_parse();
        int entity  = s~load_uint(256);
        int route   = s~load_uint(256);
        int asset   = s~load_uint(256);
        int amount  = s~load_uint(64);
        int min_coh = s~load_uint(64);
        int expiry  = s~load_uint(64);
        int status  = s~load_uint(8);
        ;; created_at lives in the overflow ref; remaining tail fields are
        ;; rebuilt from this op's inputs, so only ts is read back
        slice tl  = s~load_ref().begin_parse();
        int ts    = tl~load_uint(64);

        throw_if(ERR_ALREADY_FINAL, status != 0);

        cell new_cc = pack_commitment(entity, route, asset, amount, min_coh, expiry, 2, ts, 0, 0, now(), reason);
        ;; dict value = one ref to the record cell (matches load_ref reads)
        cdict~dict_set(256, ckey, begin_cell().store_ref(new_cc).end_cell().begin_parse());
        save_storage(owner_addr, ccount, cdict);
        return ();
    }

    ;; ── 0x10 transfer_ownership ──────────────────────────────────────────────
    if (op == 16) {
        (slice owner_addr, int ccount, cell cdict) = load_storage();
        throw_unless(ERR_UNAUTHORIZED, equal_slices(sender_addr, owner_addr));
        slice new_owner = in_msg_body~load_bits(267);
        save_storage(new_owner, ccount, cdict);
        return ();
    }
}

;; ── get_methods ───────────────────────────────────────────────────────────────

(int, int, int) get_commitment(int cid) method_id {
    (_, _, cell cdict) = load_storage();
    slice ckey = begin_cell().store_uint(cid, 256).end_cell().begin_parse();
    (slice cv, int found) = cdict.dict_get?(256, ckey);
    throw_unless(ERR_COMMITMENT_MISSING, found);
    cell cc = cv~load_ref();
    slice s = cc.begin_parse();
    s~skip_bits(256 + 256 + 256); ;; entity, route, asset
    int amount  = s~load_uint(64);
    int min_coh = s~load_uint(64);
    s~skip_bits(64);              ;; expiry
    int status  = s~load_uint(8);
    ;; amount / min_coh / status are all root-local — no ref needed here
    return (amount, min_coh, status);
}

int get_commitment_count() method_id {
    (_, int c, _) = load_storage();
    return c;
}
