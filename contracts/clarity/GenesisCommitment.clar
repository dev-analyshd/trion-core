;; GenesisCommitment.clar - §9 Sponsored Genesis, stake_bond, identity genesis
;; 3 pathways: SPONSORED, ORGANIC, INSTITUTIONAL
;; 5-layer sybil resistance (§9.3)
(define-constant ERR-NOT-OWNER (err u600))
(define-constant ERR-ALREADY-GENESIS (err u601))
(define-constant ERR-INSUFFICIENT-BOND (err u602))
(define-constant ERR-SYBIL-DETECTED (err u604))
(define-constant PATHWAY-SPONSORED u0)
(define-constant PATHWAY-ORGANIC u1)
(define-constant PATHWAY-INSTITUTIONAL u2)
(define-constant MIN-SPONSOR-BOND u1000000)
(define-map genesis-records { entity-id: (buff 32) } { pathway: uint, sponsor: principal, bond-amount: uint, created: uint, active: bool })
(define-map sponsor-bonds { sponsor: principal } { total-bonded: uint, active-sponsorships: uint })
(define-map sybil-counters { sponsor: principal } { genesis-count: uint, last-genesis-height: uint })
(define-data-var owner principal tx-sender)
(define-public (sponsored-genesis (entity-id (buff 32)) (sponsored-entity-id (buff 32)) (bond-amount uint)) (begin (asserts! (is-eq tx-sender (var-get owner)) ERR-NOT-OWNER) (asserts! (>= bond-amount MIN-SPONSOR-BOND) ERR-INSUFFICIENT-BOND) (asserts! (not (is-eq entity-id sponsored-entity-id)) ERR-SYBIL-DETECTED) (asserts! (is-none (map-get? genesis-records { entity-id: sponsored-entity-id })) ERR-ALREADY-GENESIS) (map-set genesis-records { entity-id: sponsored-entity-id } { pathway: PATHWAY-SPONSORED, sponsor: tx-sender, bond-amount: bond-amount, created: tenure-height, active: true }) (print { event: "sponsored-genesis", entity-id: sponsored-entity-id }) (ok true)))
(define-public (organic-genesis (entity-id (buff 32))) (begin (asserts! (is-eq tx-sender (var-get owner)) ERR-NOT-OWNER) (asserts! (is-none (map-get? genesis-records { entity-id: entity-id })) ERR-ALREADY-GENESIS) (map-set genesis-records { entity-id: entity-id } { pathway: PATHWAY-ORGANIC, sponsor: tx-sender, bond-amount: u0, created: tenure-height, active: true }) (print { event: "organic-genesis", entity-id: entity-id }) (ok true)))
(define-public (institutional-genesis (entity-id (buff 32)) (kyc-proof (buff 32))) (begin (asserts! (is-eq tx-sender (var-get owner)) ERR-NOT-OWNER) (asserts! (is-none (map-get? genesis-records { entity-id: entity-id })) ERR-ALREADY-GENESIS) (map-set genesis-records { entity-id: entity-id } { pathway: PATHWAY-INSTITUTIONAL, sponsor: tx-sender, bond-amount: u0, created: tenure-height, active: true }) (print { event: "institutional-genesis", entity-id: entity-id }) (ok true)))
(define-read-only (get-genesis-record (entity-id (buff 32))) (map-get? genesis-records { entity-id: entity-id }))
(define-read-only (is-genesis-active (entity-id (buff 32))) (let ((gr (map-get? genesis-records { entity-id: entity-id }))) (if (is-none gr) false (get active (unwrap-panic gr)))))
