;; BTCPEscrow.clar - BTCP escrow with quorum, etch-once, dispute fail-closed.
;; FIX C1+C3: Uses burn-block-height (not caller-supplied time)
;; FIX C2: Hard-floor quorum at max(3, ceil(2/3 * validator-count))
;; FIX C4: MIN-COHERENCE-FLOOR=550000 (0.55)
;; FIX C7: Attestations keyed by escrow-id (not route-id)

(define-constant MAX-ATTESTATION-AGE-BLOCKS u1800)
(define-constant ESCROW-STATE-HOLDING u0)
(define-constant ESCROW-STATE-RELEASED u1)
(define-constant ESCROW-STATE-REVERTED u2)
(define-constant MIN-COHERENCE-FLOOR u550000)
(define-constant MIN-QUORUM u3)

(define-map escrows { escrow-id: (buff 32) } { route-id: (buff 32), destination: principal, amount: uint, min-coherence: uint, lock-height: uint, timeout: uint, state: uint, locked-by: principal })
(define-map attestations { escrow-id: (buff 32) } { coherence: uint, execution-bh: (buff 32), count: uint, last-height: uint, disputed: bool })
(define-map has-attested { escrow-id: (buff 32), validator: principal } { value: bool })
(define-map validators { addr: principal } { active: bool })
(define-data-var validator-count uint u0)
(define-data-var quorum-required uint u3)
(define-data-var spv-verifier principal tx-sender)
(define-data-var owner principal tx-sender)

(define-private (compute-min-quorum) (let ((vc (var-get validator-count))) (if (< vc MIN-QUORUM) MIN-QUORUM (max MIN-QUORUM (+ u1 (/ (* vc u2) u3))))))
(define-private (is-validator-internal (v principal)) (is-some (map-get? validators { addr: v })))

(define-public (add-validator (v principal)) (begin (asserts! (is-eq tx-sender (var-get owner)) (err u209)) (asserts! (< (var-get validator-count) u20) (err u210)) (asserts! (is-none (map-get? validators { addr: v })) (err u107)) (map-set validators { addr: v } { active: true }) (var-set validator-count (+ u1 (var-get validator-count))) (var-set quorum-required (compute-min-quorum)) (ok true)))
(define-public (set-quorum-required (q uint)) (begin (asserts! (is-eq tx-sender (var-get owner)) (err u209)) (asserts! (>= q (compute-min-quorum)) (err u210)) (var-set quorum-required q) (ok true)))
(define-public (set-spv-verifier (v principal)) (begin (asserts! (is-eq tx-sender (var-get owner)) (err u209)) (var-set spv-verifier v) (ok true)))

(define-public (lock-escrow (escrow-id (buff 32)) (route-id (buff 32)) (destination principal) (amount uint) (min-coherence uint) (timeout uint))
  (begin (asserts! (> amount u0) (err u210)) (asserts! (>= min-coherence MIN-COHERENCE-FLOOR) (err u211)) (asserts! (is-none (map-get? escrows { escrow-id: escrow-id })) (err u201))
    (map-set escrows { escrow-id: escrow-id } { route-id: route-id, destination: destination, amount: amount, min-coherence: min-coherence, lock-height: burn-block-height, timeout: timeout, state: ESCROW-STATE-HOLDING, locked-by: tx-sender }) (print { event: "escrow-locked", escrow-id: escrow-id }) (ok true)))

(define-public (submit-attestation (escrow-id (buff 32)) (coherence uint) (execution-bh (buff 32)))
  (begin (asserts! (is-validator-internal tx-sender) (err u206)) (asserts! (is-none (map-get? has-attested { escrow-id: escrow-id, validator: tx-sender })) (err u207)) (map-set has-attested { escrow-id: escrow-id, validator: tx-sender } { value: true })
    (let ((existing (map-get? attestations { escrow-id: escrow-id })))
      (if (is-none existing) (map-set attestations { escrow-id: escrow-id } { coherence: coherence, execution-bh: execution-bh, count: u1, last-height: burn-block-height, disputed: false })
        (let ((att (unwrap-panic existing))) (if (and (is-eq coherence (get coherence att)) (is-eq execution-bh (get execution-bh att))) (map-set attestations { escrow-id: escrow-id } { coherence: (get coherence att), execution-bh: (get execution-bh att), count: (+ u1 (get count att)), last-height: burn-block-height, disputed: false }) (map-set attestations { escrow-id: escrow-id } { coherence: (get coherence att), execution-bh: (get execution-bh att), count: (get count att), last-height: burn-block-height, disputed: true })))))

    (print { event: "attestation-submitted", escrow-id: escrow-id }) (ok true)))

(define-public (release-escrow (escrow-id (buff 32)) (execution-bh (buff 32)) (coherence uint))
  (begin (let ((e (unwrap! (map-get? escrows { escrow-id: escrow-id }) (err u200)))) (asserts! (is-eq (get state e) ESCROW-STATE-HOLDING) (err u201))
    (let ((att (unwrap! (map-get? attestations { escrow-id: escrow-id }) (err u202))))
      (asserts! (>= (get count att) (var-get quorum-required)) (err u202)) (asserts! (not (get disputed att)) (err u203))
      (asserts! (is-eq coherence (get coherence att)) (err u204)) (asserts! (is-eq execution-bh (get execution-bh att)) (err u204))
      (asserts! (>= coherence MIN-COHERENCE-FLOOR) (err u212)) (asserts! (>= coherence (get min-coherence e)) (err u213))
      (asserts! (<= (- burn-block-height (get last-height att)) MAX-ATTESTATION-AGE-BLOCKS) (err u205))
      (map-set escrows { escrow-id: escrow-id } { route-id: (get route-id e), destination: (get destination e), amount: (get amount e), min-coherence: (get min-coherence e), lock-height: (get lock-height e), timeout: (get timeout e), state: ESCROW-STATE-RELEASED, locked-by: (get locked-by e) })
      (print { event: "escrow-released", escrow-id: escrow-id }) (ok true)))))

(define-public (revert-escrow (escrow-id (buff 32)) (reason uint))
  (begin (let ((e (unwrap! (map-get? escrows { escrow-id: escrow-id }) (err u200)))) (asserts! (is-eq (get state e) ESCROW-STATE-HOLDING) (err u201))
    (if (>= burn-block-height (+ (get lock-height e) (get timeout e))) (begin (map-set escrows { escrow-id: escrow-id } { route-id: (get route-id e), destination: (get destination e), amount: (get amount e), min-coherence: (get min-coherence e), lock-height: (get lock-height e), timeout: (get timeout e), state: ESCROW-STATE-REVERTED, locked-by: (get locked-by e) }) (print { event: "escrow-reverted", escrow-id: escrow-id, cause: "timeout" }) (ok true))
      (begin (asserts! (or (is-eq tx-sender (get locked-by e)) (is-eq tx-sender (var-get owner))) (err u209)) (map-set escrows { escrow-id: escrow-id } { route-id: (get route-id e), destination: (get destination e), amount: (get amount e), min-coherence: (get min-coherence e), lock-height: (get lock-height e), timeout: (get timeout e), state: ESCROW-STATE-REVERTED, locked-by: (get locked-by e) }) (print { event: "escrow-reverted", escrow-id: escrow-id, cause: "manual" }) (ok true))))))

(define-read-only (get-escrow (escrow-id (buff 32))) (map-get? escrows { escrow-id: escrow-id }))
(define-read-only (get-escrow-attestation (escrow-id (buff 32))) (map-get? attestations { escrow-id: escrow-id }))
(define-read-only (is-validator (v principal)) (is-validator-internal v))
(define-read-only (get-quorum-required) (var-get quorum-required))
(define-read-only (get-min-quorum) (compute-min-quorum))
(define-read-only (get-validator-count) (var-get validator-count))
(define-read-only (get-min-coherence-floor) MIN-COHERENCE-FLOOR)
(define-read-only (get-has-attested (escrow-id (buff 32)) (v principal)) (is-some (map-get? has-attested { escrow-id: escrow-id, validator: v })))
