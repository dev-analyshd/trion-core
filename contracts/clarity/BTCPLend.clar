;; BTCPLend.clar - Aave-like lending protocol (accounting-only, no in-contract transfers)
;; Users transfer tTRION directly to each other based on contract accounting.
;; The contract tracks: deposits, borrows, collateral, interest accrual.

(define-constant TT 'ST969AZNDX2P7N1YJ0DNVGC8QEKT388DBMXGHR9Z.triontesttoken-v4)
(define-constant CONTRACT-PRINCIPAL 'ST969AZNDX2P7N1YJ0DNVGC8QEKT388DBMXGHR9Z.btcplend-v4)

(define-constant ERR-NOT-AUTHORIZED (err u900))
(define-constant ERR-INSUFFICIENT-DEPOSIT (err u901))
(define-constant ERR-INSUFFICIENT-COLLATERAL (err u902))
(define-constant ERR-NO-COLLATERAL (err u905))
(define-constant ERR-NO-LOAN (err u906))
(define-constant ERR-LIQUIDATION-NOT-ALLOWED (err u907))
(define-constant LIQUIDATION-THRESHOLD u800000)
(define-constant LIQUIDATION-LTV u900000)
(define-constant BASE-RATE u50000)
(define-constant SLOPE u450000)
(define-constant MAX-RATE u500000)
(define-constant SCALE u1000000)

(define-map user-deposits { user: principal } { amount: uint, since: uint })
(define-map user-borrows { user: principal } { amount: uint, since: uint, anchor-bh: (buff 32) })
(define-map collateral-anchors { user: principal } { btc-txid: (buff 32), btc-block: uint, sats: uint, anchor-bh: (buff 32), liquidated: bool })
(define-data-var total-supply uint u0)
(define-data-var total-borrow uint u0)
(define-data-var utilization-rate uint u0)
(define-data-var borrow-rate uint BASE-RATE)
(define-data-var owner principal tx-sender)

(define-private (refresh-rates)
  (begin
    (if (> (var-get total-supply) u0)
      (let ((ur (/ (* (var-get total-borrow) SCALE) (var-get total-supply))))
        (var-set utilization-rate ur)
        (var-set borrow-rate (if (> (+ BASE-RATE (/ (* ur SLOPE) SCALE)) MAX-RATE) MAX-RATE (+ BASE-RATE (/ (* ur SLOPE) SCALE)))))
      (begin (var-set utilization-rate u0) (var-set borrow-rate BASE-RATE)))
    true))

(define-public (deposit (amount uint))
  (begin
    (asserts! (> amount u0) (err u901))
    (let ((existing (map-get? user-deposits { user: tx-sender })))
      (if (is-none existing)
        (map-set user-deposits { user: tx-sender } { amount: amount, since: burn-block-height })
        (let ((e (unwrap-panic existing)))
          (map-set user-deposits { user: tx-sender } { amount: (+ (get amount e) amount), since: burn-block-height })))
      (var-set total-supply (+ (var-get total-supply) amount))
      (refresh-rates)
      (print { event: "deposit", user: tx-sender, amount: amount })
      (ok true))))

(define-public (withdraw (amount uint))
  (let ((d (unwrap! (map-get? user-deposits { user: tx-sender }) (err u901))))
    (asserts! (>= (get amount d) amount) (err u901))
    (map-set user-deposits { user: tx-sender } { amount: (- (get amount d) amount), since: burn-block-height })
    (var-set total-supply (- (var-get total-supply) amount))
    (refresh-rates)
    (print { event: "withdraw", user: tx-sender, amount: amount })
    (ok true)))

(define-public (register-btc-collateral (btc-txid (buff 32)) (btc-block uint) (sats uint) (anchor-bh (buff 32)))
  (begin
    (asserts! (> sats u0) (err u902))
    (map-set collateral-anchors { user: tx-sender } { btc-txid: btc-txid, btc-block: btc-block, sats: sats, anchor-bh: anchor-bh, liquidated: false })
    (print { event: "collateral-registered", user: tx-sender, sats: sats, anchor-bh: anchor-bh })
    (ok true)))

(define-public (borrow (amount uint) (anchor-bh (buff 32)))
  (let ((c (unwrap! (map-get? collateral-anchors { user: tx-sender }) (err u905))))
    (asserts! (not (get liquidated c)) (err u905))
    (let ((existing-borrow (map-get? user-borrows { user: tx-sender })))
      (let ((current-debt (if (is-none existing-borrow) u0 (get amount (unwrap-panic existing-borrow)))))
        (asserts! (<= (+ current-debt amount) (/ (* (get sats c) LIQUIDATION-THRESHOLD) SCALE)) (err u902))
        (map-set user-borrows { user: tx-sender } { amount: (+ current-debt amount), since: burn-block-height, anchor-bh: anchor-bh })
        (var-set total-borrow (+ (var-get total-borrow) amount))
        (refresh-rates)
        (print { event: "borrow", user: tx-sender, amount: amount, anchor-bh: anchor-bh })
        (ok true)))))

(define-public (repay (amount uint))
  (let ((b (unwrap! (map-get? user-borrows { user: tx-sender }) (err u906))))
    (asserts! (> amount u0) (err u906))
    (let ((new-amount (if (>= amount (get amount b)) u0 (- (get amount b) amount))))
      (if (is-eq new-amount u0)
        (map-delete user-borrows { user: tx-sender })
        (map-set user-borrows { user: tx-sender } { amount: new-amount, since: burn-block-height, anchor-bh: (get anchor-bh b) }))
      (var-set total-borrow (- (var-get total-borrow) (- (get amount b) new-amount)))
      (refresh-rates)
      (print { event: "repay", user: tx-sender, amount: amount })
      (ok true))))

(define-public (liquidate (user principal))
  (let ((c (unwrap! (map-get? collateral-anchors { user: user }) (err u905)))
        (b (unwrap! (map-get? user-borrows { user: user }) (err u906))))
    (asserts! (> (get amount b) (/ (* (get sats c) LIQUIDATION-LTV) SCALE)) (err u907))
    (map-set collateral-anchors { user: user } { btc-txid: (get btc-txid c), btc-block: (get btc-block c), sats: (get sats c), anchor-bh: (get anchor-bh c), liquidated: true })
    (map-delete user-borrows { user: user })
    (var-set total-borrow (- (var-get total-borrow) (get amount b)))
    (refresh-rates)
    (print { event: "liquidate", user: user, debt-cleared: (get amount b) })
    (ok true)))

(define-public (set-borrow-rate (rate uint))
  (begin (asserts! (is-eq tx-sender (var-get owner)) ERR-NOT-AUTHORIZED) (var-set borrow-rate rate) (ok true)))

(define-public (set-liquidation-threshold (threshold uint))
  (begin (asserts! (is-eq tx-sender (var-get owner)) ERR-NOT-AUTHORIZED) (ok true)))

(define-read-only (get-deposit (user principal)) (map-get? user-deposits { user: user }))
(define-read-only (get-borrow (user principal)) (map-get? user-borrows { user: user }))
(define-read-only (get-collateral (user principal)) (map-get? collateral-anchors { user: user }))
(define-read-only (get-utilization-rate) (var-get utilization-rate))
(define-read-only (get-borrow-rate) (var-get borrow-rate))
(define-read-only (get-total-supply) (var-get total-supply))
(define-read-only (get-total-borrow) (var-get total-borrow))
(define-read-only (get-accrued-interest (user principal))
  (let ((b (map-get? user-borrows { user: user })))
    (if (is-none b) u0 (let ((loan (unwrap-panic b))) (/ (* (get amount loan) (var-get borrow-rate) (- burn-block-height (get since loan))) SCALE)))))
(define-read-only (get-owner) (var-get owner))
