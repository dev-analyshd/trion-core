;; TravelRuleCompliance.clar - S11 Fix 1: FATF Travel Rule, 4 tiers, AWA freeze
(define-constant ERR-NOT-OWNER (err u700))
(define-constant ERR-ALREADY-FILED (err u701))
(define-constant ERR-AWA-FROZEN (err u702))
(define-constant ERR-INVALID-TIER (err u703))
(define-constant ERR-PROOF-MISSING (err u704))
(define-constant TIER-LOW u0)
(define-constant TIER-MEDIUM u1)
(define-constant TIER-HIGH u2)
(define-constant TIER-CRITICAL u3)
(define-map travel-rule-proofs { entity-id: (buff 32) } { disclosure-hash: (buff 32), tier: uint, filed: uint, awa-frozen: bool })
(define-data-var owner principal tx-sender)
(define-data-var awa-global-freeze bool false)
(define-public (file-travel-rule-proof (entity-id (buff 32)) (disclosure-hash (buff 32)) (tier uint)) (begin (asserts! (is-eq tx-sender (var-get owner)) ERR-NOT-OWNER) (asserts! (<= tier TIER-CRITICAL) ERR-INVALID-TIER) (asserts! (is-none (map-get? travel-rule-proofs { entity-id: entity-id })) ERR-ALREADY-FILED) (asserts! (not (var-get awa-global-freeze)) ERR-AWA-FROZEN) (if (is-eq tier TIER-CRITICAL) (var-set awa-global-freeze true) true) (map-set travel-rule-proofs { entity-id: entity-id } { disclosure-hash: disclosure-hash, tier: tier, filed: tenure-height, awa-frozen: (is-eq tier TIER-CRITICAL) }) (print { event: "travel-rule-filed", entity-id: entity-id, tier: tier }) (ok true)))
(define-public (verify-travel-rule (entity-id (buff 32))) (let ((proof (map-get? travel-rule-proofs { entity-id: entity-id }))) (if (is-none proof) (err ERR-PROOF-MISSING) (ok (unwrap-panic proof)))))
(define-public (clear-awa-freeze) (begin (asserts! (is-eq tx-sender (var-get owner)) ERR-NOT-OWNER) (var-set awa-global-freeze false) (ok true)))
