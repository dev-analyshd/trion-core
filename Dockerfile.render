# =============================================================================
# TRION Protocol — Production Dockerfile  (v5.0 — React + Flask + Rust)
# =============================================================================
#
# Multi-stage build:
#   Stage 1: rust-builder  — compiles all 14 Rust L0 indexer binaries
#   Stage 2: node-builder  — npm install for all Node.js relayers & chains
#   Stage 3: next-builder  — builds Next.js React frontend (standalone)
#   Stage 4: runtime       — Python 3.11 + Node.js 20 + Rust bins + Next.js
#
# Services (render-entrypoint.sh):
#   1. FAISS ANIMA Engine         Python  port 8000 (internal)
#   2. Rust L0 Indexers           Rust    background
#   3. EVM + Non-EVM Indexers     Bash    background
#   4. Unified Relayer (2)        Node    background
#   5. 0G Sync + DA Daemon        Python  background
#   6. Flask Oracle API           Python  port 5000 (internal)
#   7. Next.js React Frontend     Node    port $PORT (exposed)
#
# Next.js proxies /api/* to Flask internally — single exposed port.
# =============================================================================

# ─── Stage 1: Rust builder ───────────────────────────────────────────────────
FROM rust:1.78-slim AS rust-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev libpq-dev clang cmake git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY indexers/Cargo.toml  ./indexers/Cargo.toml
COPY indexers/Cargo.lock* ./indexers/
COPY indexers/crates/     ./indexers/crates/

RUN cd indexers && cargo build --release --workspace 2>&1 | tail -30

# ─── Stage 2: Node builder (relayers + chains) ──────────────────────────────
FROM node:20-slim AS node-builder

WORKDIR /build

COPY package.json package-lock.json ./
RUN npm install --omit=dev --legacy-peer-deps --silent

COPY relayer/package.json        relayer/package-lock.json        ./relayer/
RUN cd relayer && npm install --omit=dev --legacy-peer-deps --silent

COPY trion-0g/package.json trion-0g/package-lock.json ./trion-0g/
RUN cd trion-0g && npm install --omit=dev --legacy-peer-deps --silent

COPY chains/near/package.json      chains/near/package-lock.json      ./chains/near/
COPY chains/pvm/package.json       chains/pvm/package-lock.json       ./chains/pvm/
COPY chains/starknet/package.json  chains/starknet/package-lock.json  ./chains/starknet/
COPY chains/sui/package.json       chains/sui/package-lock.json       ./chains/sui/
COPY chains/svm/package.json       chains/svm/package-lock.json       ./chains/svm/
COPY chains/ton/package.json       chains/ton/package-lock.json       ./chains/ton/
COPY chains/botchain/package.json                                    ./chains/botchain/
RUN for d in chains/near chains/pvm chains/starknet chains/sui chains/svm chains/ton chains/botchain; do \
        cd /build/$d && npm install --omit=dev --legacy-peer-deps --silent && cd /build; \
    done

# ─── Stage 3: Next.js builder (React frontend) ──────────────────────────────
FROM node:20-slim AS next-builder

WORKDIR /build

# Copy the frontend package.json and install deps
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --legacy-peer-deps

# Copy frontend source
COPY frontend/ ./

# Set API proxy target to Flask internal port
ENV NEXT_PUBLIC_API_BASE=""

# Build Next.js standalone (must succeed — no || true)
RUN npm run build

# ─── Stage 4: Runtime ───────────────────────────────────────────────────────
FROM python:3.11-slim

LABEL maintainer="TRION Protocol"
LABEL description="TRION Protocol — React + Flask + Rust (v5.0)"
LABEL org.opencontainers.image.source="https://github.com/dev-analyshd/trion-core"
LABEL version="5.0.0"

# ── System: Node.js 20, curl, tini, build tools ───────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl bash tini ca-certificates gnupg libssl3 libpq5 \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] \
       https://deb.nodesource.com/node_20.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g tsx typescript --silent \
    && rm -rf /var/lib/apt/lists/*

# ── Rust binaries ────────────────────────────────────────────────────────────
COPY --from=rust-builder /build/indexers/target/release/ /app/bin/
RUN chmod +x /app/bin/trion-* 2>/dev/null || true

# ── Node modules ─────────────────────────────────────────────────────────────
COPY --from=node-builder /build/node_modules          /app/node_modules
COPY --from=node-builder /build/relayer/node_modules  /app/relayer/node_modules
COPY --from=node-builder /build/trion-0g/node_modules /app/trion-0g/node_modules
COPY --from=node-builder /build/chains/near/node_modules      /app/chains/near/node_modules
COPY --from=node-builder /build/chains/pvm/node_modules       /app/chains/pvm/node_modules
COPY --from=node-builder /build/chains/starknet/node_modules  /app/chains/starknet/node_modules
COPY --from=node-builder /build/chains/sui/node_modules       /app/chains/sui/node_modules
COPY --from=node-builder /build/chains/svm/node_modules       /app/chains/svm/node_modules
COPY --from=node-builder /build/chains/ton/node_modules       /app/chains/ton/node_modules
COPY --from=node-builder /build/chains/botchain/node_modules   /app/chains/botchain/node_modules

# ── Next.js standalone build ─────────────────────────────────────────────────
# In Docker, the build root is /build/ (WORKDIR). Since there's no monorepo
# parent, standalone output is FLAT at /build/.next/standalone/server.js
# (NOT nested under frontend/ like in local builds).
COPY --from=next-builder /build/.next/standalone/ /app/frontend/
COPY --from=next-builder /build/.next/static /app/frontend/.next/static
COPY --from=next-builder /build/public /app/frontend/public
# Also copy the Next.js config so rewrites() work at runtime
COPY --from=next-builder /build/next.config.js /app/frontend/next.config.js

WORKDIR /app

# ── Python: Oracle API + FAISS ANIMA + 0G daemons ────────────────────────────
COPY api/requirements.txt ./api/requirements.txt
COPY anima-service/requirements.txt    ./anima-service/requirements.txt
RUN pip install --no-cache-dir \
        -r api/requirements.txt \
        -r anima-service/requirements.txt \
        numpy scipy scikit-learn gunicorn
# PHASE-1-SECURITY: force-upgrade pynacl (cosmpy transitively pins 1.6.0
# which has PYSEC-2026-3002). --no-deps avoids the cosmpy resolver conflict.
RUN pip install --no-cache-dir --no-deps pynacl==1.6.2

# ── Full source copy ───────────────────────────────────────────────────────────
COPY api/             ./api/
COPY anima-service/   ./anima-service/
COPY core/            ./core/
# src/ was removed (deprecated shim layer) — all code is in core/
COPY relayer/         ./relayer/
COPY chains/          ./chains/
COPY trion-0g/        ./trion-0g/
COPY contracts/       ./contracts/
COPY supervisors/     ./supervisors/
COPY scripts/         ./scripts/
COPY config/          ./config/
COPY shared/          ./shared/
COPY math/            ./math/
COPY sdk/             ./sdk/
COPY proof-ledger/    ./proof-ledger/
COPY serve.py         ./serve.py
COPY main.py          ./main.py
COPY zg/              ./zg/
COPY schema.sql       ./schema.sql
COPY package.json     ./package.json
COPY tsconfig.json    ./tsconfig.json
# NOTE: Do NOT copy frontend/ source over the standalone build.
# The standalone server.js + .next/static are already copied above.
# Copying frontend/src/ here would overwrite the standalone output.

# ── bh_ledger.db initialization ──────────────────────────────────────────────
RUN python3 -c "
import sqlite3
c = sqlite3.connect('/app/bh_ledger.db')
c.execute('''CREATE TABLE IF NOT EXISTS bh_ledger (
    id INTEGER PRIMARY KEY AUTOINCREMENT, tx_hash TEXT UNIQUE,
    entity_id TEXT, from_addr TEXT, to_addr TEXT,
    event_type INTEGER, event_type_name TEXT,
    magnitude_norm REAL, value_wei TEXT, selector TEXT,
    sense_hex TEXT, antisense_hex TEXT,
    block_num INTEGER, block_hash TEXT,
    chain_id INTEGER, chain_label TEXT, ts REAL
)''')
c.execute('CREATE INDEX IF NOT EXISTS bh_ledger_entity ON bh_ledger(entity_id)')
c.execute('CREATE INDEX IF NOT EXISTS bh_ledger_chain ON bh_ledger(chain_id)')
c.execute('CREATE INDEX IF NOT EXISTS bh_ledger_ts ON bh_ledger(ts DESC)')
c.commit(); c.close()
print('bh_ledger.db initialized')
"

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY render-entrypoint.sh ./render-entrypoint.sh
RUN chmod +x ./render-entrypoint.sh ./supervisors/*.sh 2>/dev/null || true

# Runtime dirs
RUN mkdir -p 0g-state/logs 0g-state/exports 0g-state/proofs /tmp/trion-rust-logs anima-service/data

# ── Environment ───────────────────────────────────────────────────────────────
ENV PORT=10000 \
    FAISS_PORT=8000 \
    FLASK_PORT=5000 \
    FAISS_SERVICE_URL=http://127.0.0.1:8000 \
    FAISS_URL=http://127.0.0.1:8000 \
    ORACLE_API_URL=http://127.0.0.1:5000 \
    FLASK_URL=http://127.0.0.1:5000 \
    RUST_BIN_DIR=/app/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ZG_NETWORK=mainnet \
    ZG_CHAIN_ID=16661 \
    ZERO_G_RPC=https://evmrpc.0g.ai \
    ZG_EXECUTION_GATE_ADDR=0xA85B49C73B5710d9ddB1CB5a94c52D0F33c4199b \
    TRION_ENABLE_FAISS=1 \
    TRION_ENABLE_RUST=1 \
    TRION_ENABLE_RELAYER=1 \
    TRION_ENABLE_ZG_SYNC=1 \
    TRION_ENABLE_ZG_DA=1 \
    DATABASE_URL="" \
    TIMESCALEDB_URL=""

EXPOSE 10000

HEALTHCHECK --interval=20s --timeout=8s --start-period=120s --retries=6 \
    CMD curl -fs http://localhost:${PORT:-10000}/api/v1/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/render-entrypoint.sh"]
