{
  "filter_paths": "node_modules|test|mock|Mock",
  "exclude_informational": false,
  "exclude_low": false,
  "exclude_medium": false,
  "exclude_high": false,
  "solc_remaps": [
    "@openzeppelin/=node_modules/@openzeppelin/"
  ],
  "detectors_to_run": "all",
  "ignore_paths": [
    "contracts/test/",
    "contracts/MockTRIONToken.sol",
    "contracts/MockOracle.sol",
    "contracts/AttackSimulator.sol",
    "hardhat/"
  ]
}
